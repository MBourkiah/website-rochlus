---
/**
 * Ablauf auf Graphit (einziger dunkler Abschnitt, Rhythmuswechsel): riesige
 * Ziffern, ein Strich zieht sich beim Scrollen mit. Die Nummern tragen
 * Information (Reihenfolge). Inhalte aus den Bestandsleistungen.
 */
const schritte = [
  { titel: 'Besichtigung vor Ort', text: 'Wir kommen zu Ihnen, sehen uns Raum und Untergrund an und sagen offen, was geht.' },
  { titel: 'Planung', text: 'Material, Format, Verlegebild und Budget legen wir gemeinsam fest. Sie entscheiden.' },
  { titel: 'Ausführung', text: 'Wir liefern das Material an, führen die Arbeiten aus und überwachen jeden Schritt selbst.' },
  { titel: 'Übergabe', text: 'Wir nehmen gemeinsam ab, bis zur letzten Fuge. Kleine Reparaturen übernehmen wir auch später.' },
];
---

<section id="ablauf" class="dunkel scroll-mt-20 bg-graphit text-papier">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:py-32">
    <h2 class="max-w-2xl text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">In vier Schritten zum fertigen Bad.</h2>

    <div class="relative mt-16" data-bewegung="strich">
      <span class="bleistiftstrich ablauf-strich absolute top-[3.9rem] right-0 left-0 hidden h-[2px] bg-kraft lg:block" aria-hidden="true"></span>
      <span class="bleistiftstrich senkrecht ablauf-strich absolute top-6 bottom-6 left-[1.4rem] w-[2px] bg-kraft lg:hidden" aria-hidden="true"></span>
      <ol class="relative grid grid-cols-1 gap-14 lg:grid-cols-4 lg:gap-8">
        {
          schritte.map((s, i) => (
            <li class="schritt relative pl-16 lg:pl-0" style={`--i:${i}`}>
              <span class="ziffer schmal absolute top-0 left-0 block text-[3rem] leading-none font-extrabold lg:relative lg:text-[7.5rem] lg:leading-[0.75]" aria-hidden="true">
                <span class="bg-graphit pr-3">{i + 1}</span>
              </span>
              <h3 class="text-[1.7rem] leading-tight lg:mt-8">
                <span class="sr-only">Schritt {i + 1}: </span>
                {s.titel}
              </h3>
              <p class="mt-2 text-base leading-relaxed text-papier/75">{s.text}</p>
              {i === 0 && (
                <p class="mt-4 text-base">
                  Erst mal ansehen lassen?{' '}
                  <a href="tel:+492219687575" class="link ziel schmal text-xl font-bold whitespace-nowrap text-papier [text-decoration-color:var(--kreide)]">0221 968 75 75</a>
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
