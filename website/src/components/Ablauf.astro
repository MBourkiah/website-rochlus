---
/**
 * Ablauf als vier feste Stationen, jede mit einem Hausnummern-Schild.
 * Die Nummer trägt Information (Reihenfolge). Jede Station nennt schon den
 * nächsten Schritt, damit niemand rätseln muss, was danach passiert.
 * Inhalte aus den Bestandsleistungen: Besichtigung, Planung, Materialanlieferung,
 * Überwachung, Reparaturen.
 */
const stationen = [
  {
    titel: 'Besichtigung vor Ort',
    text: 'Wir kommen zu Ihnen, sehen uns Raum und Untergrund an und sagen offen, was geht.',
    danach: 'Wir planen mit Ihnen.',
  },
  {
    titel: 'Planung',
    text: 'Material, Format, Verlegebild und Budget legen wir gemeinsam fest. Sie entscheiden.',
    danach: 'Wir legen los.',
  },
  {
    titel: 'Ausführung',
    text: 'Wir liefern das Material an, führen die Arbeiten aus und überwachen jeden Schritt selbst.',
    danach: 'Gemeinsame Abnahme.',
  },
  {
    titel: 'Übergabe',
    text: 'Wir nehmen gemeinsam ab, bis zur letzten Fuge. Kleine Reparaturen übernehmen wir auch später.',
    danach: 'Ihr Raum ist fertig.',
  },
];
---

<section id="ablauf" class="scroll-mt-20 border-t border-linie">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
    <h2 class="max-w-2xl text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Vier Stationen bis zum fertigen Raum.</h2>

    <ol class="mt-14 grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        stationen.map((s, i) => (
          <li class="flex flex-col">
            <span class="schild schild--kobalt flex h-24 w-24 items-center justify-center font-schild text-6xl leading-none font-bold [--rand-abstand:6px] [--schraube-abstand:13px]">
              <span class="sr-only">Station </span>
              {i + 1}
            </span>
            <h3 class="mt-6 text-2xl leading-tight">{s.titel}</h3>
            <p class="mt-2 text-base leading-relaxed text-anthrazit-soft">{s.text}</p>
            <p class="mt-auto flex items-center gap-2 border-t border-linie pt-3 text-base">
              <svg class="mt-px shrink-0 text-kobalt" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
              <span>
                <span class="font-semibold">Danach:</span> {s.danach}
              </span>
            </p>
          </li>
        ))
      }
    </ol>

    <p class="mt-16 text-lg">
      Station 1 beginnt mit einem Anruf:{' '}
      <a href="tel:+492219687575" class="link link-anruf ziel font-schild text-2xl font-semibold whitespace-nowrap">0221 968 75 75</a>
    </p>
  </div>
</section>
