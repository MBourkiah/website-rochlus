---
/**
 * Ablauf in vier Schritten, verbunden durch einen Bleistiftstrich, der sich
 * einmal durchzieht. Die Nummern tragen Information (Reihenfolge). Jeder
 * Schritt nennt schon den nächsten. Inhalte aus den Bestandsleistungen.
 */
const schritte = [
  { titel: 'Besichtigung vor Ort', text: 'Wir kommen zu Ihnen, sehen uns Raum und Untergrund an und sagen offen, was geht.', danach: 'Wir planen mit Ihnen.' },
  { titel: 'Planung', text: 'Material, Format, Verlegebild und Budget legen wir gemeinsam fest. Sie entscheiden.', danach: 'Wir legen los.' },
  { titel: 'Ausführung', text: 'Wir liefern das Material an, führen die Arbeiten aus und überwachen jeden Schritt selbst.', danach: 'Gemeinsame Abnahme.' },
  { titel: 'Übergabe', text: 'Wir nehmen gemeinsam ab, bis zur letzten Fuge. Kleine Reparaturen übernehmen wir auch später.', danach: 'Ihr Raum ist fertig.' },
];
---

<section id="ablauf" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
    <h2 class="max-w-2xl text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">In vier Schritten zum fertigen Bad.</h2>

    <div class="relative mt-14 lg:mt-20" data-bewegung="strich">
      <!-- Bleistiftstrich: waagerecht ab lg, senkrecht darunter -->
      <span class="bleistiftstrich absolute top-[2.1rem] right-0 left-0 hidden h-[1.5px] bg-graphit lg:block" aria-hidden="true"></span>
      <span class="bleistiftstrich senkrecht absolute top-4 bottom-4 left-[1.05rem] w-[1.5px] bg-graphit lg:hidden" aria-hidden="true"></span>
      <ol class="relative grid grid-cols-1 gap-12 lg:grid-cols-4 lg:gap-8">
        {
          schritte.map((s, i) => (
            <li class="relative pl-14 lg:pl-0">
              <span class="schmal absolute top-0 left-0 grid h-9 w-9 place-items-center rounded-full bg-graphit text-lg font-bold text-papier lg:relative lg:top-auto lg:h-auto lg:w-auto lg:place-items-start lg:rounded-none lg:bg-transparent lg:text-graphit" aria-hidden="true">
                <span class="lg:inline-block lg:bg-putz lg:pr-3 lg:text-[3.5rem] lg:leading-none">{i + 1}</span>
              </span>
              <h3 class="text-2xl leading-tight lg:mt-6">
                <span class="sr-only">Schritt {i + 1}: </span>
                {s.titel}
              </h3>
              <p class="mt-2 text-base leading-relaxed text-graphit-soft">{s.text}</p>
              <p class="mt-4 text-base">
                <span class="font-semibold">Danach:</span> {s.danach}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
