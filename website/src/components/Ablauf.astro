---
/**
 * Ablauf in vier nummerierten Schritten (die Nummer trägt die Reihenfolge).
 */
const schritte = [
  { titel: 'Besichtigung vor Ort', text: 'Wir kommen zu Ihnen, sehen uns Raum und Untergrund an und sagen offen, was geht.' },
  { titel: 'Planung', text: 'Material, Format, Verlegebild und Budget legen wir gemeinsam fest. Sie entscheiden.' },
  { titel: 'Ausführung', text: 'Wir liefern das Material an, führen die Arbeiten aus und überwachen jeden Schritt selbst.' },
  { titel: 'Übergabe', text: 'Wir nehmen gemeinsam ab, bis zur letzten Fuge. Kleine Reparaturen übernehmen wir auch später.' },
];
---

<section id="ablauf" class="scroll-mt-20 bg-hell">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="einblenden max-w-2xl">
      <h2 class="text-[clamp(2rem,3.6vw,2.75rem)] leading-tight">So läuft Ihr Projekt ab</h2>
      <p class="mt-4 text-lg text-tinte-soft">In vier Schritten vom ersten Anruf zum fertigen Bad.</p>
    </div>
    <ol class="mt-12 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        schritte.map((s, i) => (
          <li class="einblenden border-t border-tinte pt-6">
            <span class="block text-[2.75rem] leading-none font-bold text-linie" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-xl">
              <span class="sr-only">Schritt {i + 1}: </span>
              {s.titel}
            </h3>
            <p class="mt-2 text-[0.98rem] leading-relaxed text-tinte-soft">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
