---
/**
 * Der Anhänger: Kraftpapier mit Ösenring und rotem Stempel „Anrufen“.
 * Er ist der Anruf (tel:-Link). `hero` markiert das Anruf-Element des ersten
 * Bildschirms (Ein-Rot-Logik in Base.astro), `kontakt` das am Seitenende.
 */
import Telefon from './Telefon.astro';

interface Props {
  hero?: boolean;
  kontakt?: boolean;
  gross?: boolean;
  zusatz?: string;
}
const { hero = false, kontakt = false, gross = false, zusatz = 'Sie sprechen direkt mit dem Betrieb.' } = Astro.props;
---

<a
  href="tel:+492219687575"
  class="anhaenger"
  data-hero-anruf={hero ? '' : undefined}
  data-klingel={kontakt ? '' : undefined}
  aria-label="Anrufen: 0221 968 75 75"
>
  <span class="anhaenger-form">
    <span class="flex flex-col gap-1.5">
      <span class="flex items-center gap-3">
        <span class="stempel text-sm">Anrufen</span>
        <Telefon size={18} class="text-kreide-tief" />
      </span>
      <span class={`schmal block leading-none font-bold whitespace-nowrap ${gross ? 'text-[clamp(2.4rem,7vw,4.2rem)]' : 'text-[clamp(2rem,5vw,2.6rem)]'}`}>0221 968 75 75</span>
      <span class="block text-[0.95rem] leading-snug">{zusatz}</span>
    </span>
  </span>
</a>
