---
/**
 * Über uns: Text links, Faktenliste rechts. Porträt aus src/fotos.mjs,
 * sonst nur im Review-Stand ein Platzhalter. Unbestätigtes nur im Review-Stand.
 */
import { Image } from 'astro:assets';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import { istReview } from '../stand';
import { fotos } from '../fotos.mjs';

const fakten = [
  ['Ansprechpartner', 'Marc Rochlus, Geschäftsführer'],
  ['Sitz', 'Kranzbinderweg 15, 51067 Köln'],
  ['Einsatzgebiet', 'Köln und Umgebung'],
  ['Unternehmen', 'Inhabergeführte GmbH'],
];
---

<section id="betrieb" class="scroll-mt-20 bg-weiss">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-28">
    <div class="einblenden">
      <h2 class="text-[clamp(2rem,3.6vw,2.75rem)] leading-tight">Über uns</h2>
      <p class="mt-5 text-lg leading-relaxed text-tinte-soft">
        Die Fliesenfachbetrieb Rochlus GmbH sitzt im Kranzbinderweg in Köln und wird
        vom Inhaber geführt. Wer anruft, spricht direkt mit dem Betrieb, nicht mit einem
        Vermittlungsportal. Wer beauftragt, bekommt die Arbeit vom Fachbetrieb, nicht von
        wechselnden Kolonnen.
      </p>
      {
        fotos.inhaber ? (
          <figure class="mt-8 flex items-center gap-4">
            <Image src={fotos.inhaber.bild} alt={fotos.inhaber.alt} widths={[160, 240]} sizes="5rem" class="h-20 w-20 rounded-full object-cover" />
            <figcaption>
              <span class="block font-bold">Marc Rochlus</span>
              <span class="text-tinte-soft">Geschäftsführer</span>
            </figcaption>
          </figure>
        ) : (
          istReview && (
            <div class="mt-8 rounded-lg border border-dashed border-tinte-soft/40 p-5">
              <PlatzhalterBadge text="In Klärung mit dem Betrieb" />
              <p class="mt-2 text-sm text-tinte-soft">Porträt, Gründungsjahr, Meister-Qualifikation und genaues Einzugsgebiet folgen, sobald der Betrieb sie bestätigt.</p>
            </div>
          )
        )
      }
    </div>
    <dl class="einblenden karte divide-y divide-linie self-start">
      {
        fakten.map(([k, v]) => (
          <div class="grid grid-cols-1 gap-1 px-6 py-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="text-tinte-soft">{k}</dt>
            <dd class="font-semibold">{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
