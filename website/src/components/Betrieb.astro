---
/**
 * Der Betrieb: links die Aussage, rechts der Werkstattzettel (Kraftpapier)
 * mit den belegten Fakten. Porträt aus src/fotos.mjs, sonst nur im
 * Review-Stand ein Platzhalter. Unbestätigtes im Klärungskasten (nur Review).
 * WICHTIG: Meisterbetrieb/Gründungsjahr NICHT setzen, bis der Kunde bestätigt.
 */
import { Image } from 'astro:assets';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import Zwinge from './Zwinge.astro';
import { istReview } from '../stand';
import { fotos } from '../fotos.mjs';
---

<section id="betrieb" class="scroll-mt-20 border-t border-linie">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:py-28">
    <div class="lg:col-span-6">
      <h2 class="text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Ein Kölner Betrieb. Kein Vermittlungsportal.</h2>
      <p class="mt-7 max-w-lg text-lg leading-relaxed text-graphit-soft">
        Die Fliesenfachbetrieb Rochlus GmbH sitzt im Kranzbinderweg in Köln und
        wird vom Inhaber geführt. Wer anruft, spricht direkt mit dem Betrieb. Wer
        beauftragt, bekommt die Arbeit vom Fachbetrieb, nicht von wechselnden Kolonnen.
      </p>
      {
        fotos.inhaber ? (
          <figure class="mt-10 flex items-center gap-5">
            <span class="probe w-32 shrink-0 sm:w-40">
              <Image src={fotos.inhaber.bild} alt={fotos.inhaber.alt} widths={[256, 384]} sizes="10rem" class="aspect-4/5 w-full object-cover" />
            </span>
            <figcaption class="text-base text-graphit-soft">
              <span class="schmal block text-xl font-bold text-graphit">Marc Rochlus</span>
              Geschäftsführer
            </figcaption>
          </figure>
        ) : (
          istReview && (
            <figure class="mt-10 flex items-center gap-5">
              <span class="grid aspect-4/5 w-32 shrink-0 place-items-center border border-dashed border-zink bg-papier sm:w-36">
                <PlatzhalterBadge text="Foto folgt" />
              </span>
              <figcaption class="text-sm text-graphit-soft">
                <span class="schmal block text-xl font-bold text-graphit">Marc Rochlus</span>
                Geschäftsführer. Hier kommt ein Foto von ihm oder dem Team hin.
              </figcaption>
            </figure>
          )
        )
      }
    </div>

    <!-- Werkstattzettel: Kraftpapier, mit der Zwinge an die Wand geklemmt -->
    <div class="lg:col-span-5 lg:col-start-8 lg:pt-8">
      <div class="relative rotate-[0.8deg] bg-kraft px-8 pt-10 pb-8 shadow-[var(--schatten-haengend)] sm:px-10">
        <Zwinge class="absolute -top-[2.35rem] left-1/2 z-10 w-[4.25rem] -translate-x-1/2 text-zink drop-shadow-[0_2px_2px_rgb(30_28_24/0.3)]" />
        <p class="schmal text-3xl leading-none font-bold">Fliesenfachbetrieb Rochlus&nbsp;GmbH</p>
        <dl class="mt-6 space-y-3 border-t border-graphit/25 pt-5 text-base">
          <div class="grid grid-cols-[auto_1fr] gap-x-6">
            <dt>Ansprechpartner</dt>
            <dd class="schmal text-lg font-bold">Marc Rochlus, Geschäftsführer</dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-x-6">
            <dt>Sitz</dt>
            <dd class="font-semibold">Kranzbinderweg 15, 51067 Köln</dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-x-6">
            <dt>Einsatz</dt>
            <dd class="font-semibold">Köln und Umgebung</dd>
          </div>
        </dl>
      </div>
      {
        istReview && (
          <div class="mt-8 border border-dashed border-zink px-5 py-4">
            <PlatzhalterBadge text="In Klärung mit dem Betrieb" />
            <p class="mt-2 text-sm leading-relaxed text-graphit-soft">
              Gründungsjahr, Meister-Qualifikation und genaues Einzugsgebiet werden
              ergänzt, sobald der Betrieb sie bestätigt.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
