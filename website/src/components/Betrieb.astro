---
/**
 * Der Betrieb: das Firmenschild neben der Tür. Nur belegte Fakten stehen auf
 * dem Schild (GmbH, Marc Rochlus, Adresse). Alles Unbestätigte liegt in EINEM
 * gebündelten Klärungskasten.
 * Im Launch-Stand entfallen Foto-Platzhalter und Klärungskasten (src/stand.ts).
 * WICHTIG: Meisterbetrieb/Gründungsjahr NICHT setzen, bis der Kunde bestätigt.
 */
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import { istReview } from '../stand';
---

<section id="betrieb" class="scroll-mt-20 border-y border-linie bg-putz-tief/60">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:py-28">
    <div class="lg:col-span-6">
      <h2 class="text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Ein Kölner Betrieb. Kein Vermittlungsportal.</h2>
      <p class="mt-7 max-w-136 text-lg leading-relaxed text-anthrazit-soft">
        Die Fliesenfachbetrieb Rochlus GmbH sitzt im Kranzbinderweg in Köln und
        wird vom Inhaber geführt. Wer anruft, spricht direkt mit dem Betrieb. Wer
        beauftragt, bekommt die Arbeit vom Fachbetrieb, nicht von wechselnden Kolonnen.
      </p>

      <!-- Inhaber-Foto: kompakter Platzhalter unter dem Text, dem Firmenschild untergeordnet -->
      {istReview && (
      <figure class="mt-10 flex items-center gap-5">
        <div class="flex aspect-4/5 w-32 shrink-0 flex-col items-center justify-center gap-2 rounded-[6px] border border-dashed border-stahl bg-emaille p-2 text-center sm:w-36">
          <PlatzhalterBadge text="Foto folgt" />
        </div>
        <figcaption class="text-sm leading-relaxed text-anthrazit-soft">
          <span class="block font-schild text-lg font-semibold text-anthrazit">Marc Rochlus</span>
          Geschäftsführer. Hier kommt ein Foto von ihm oder dem Team hin.
        </figcaption>
      </figure>
      )}
    </div>

    <div class="lg:col-span-6 lg:col-start-7 lg:pt-2">
      <!-- Das Firmenschild -->
      <div class="schild schild--flach max-w-lg px-10 pt-12 pb-10 sm:px-12">
        <p class="font-schild text-3xl leading-none font-semibold sm:text-4xl">Fliesenfachbetrieb Rochlus GmbH</p>
        <dl class="mt-7 space-y-3 border-t border-anthrazit/15 pt-5 text-base">
          <div class="flex flex-wrap justify-between gap-x-6">
            <dt class="text-anthrazit-soft">Ihr Ansprechpartner</dt>
            <dd class="font-schild text-xl font-semibold">Marc Rochlus, Geschäftsführer</dd>
          </div>
          <div class="flex flex-wrap justify-between gap-x-6">
            <dt class="text-anthrazit-soft">Sitz</dt>
            <dd class="font-medium">Kranzbinderweg 15, 51067 Köln</dd>
          </div>
          <div class="flex flex-wrap justify-between gap-x-6">
            <dt class="text-anthrazit-soft">Einsatz</dt>
            <dd class="font-medium">Köln und Umgebung</dd>
          </div>
        </dl>
      </div>

      {istReview && (
      <div class="mt-6 max-w-lg rounded-lg border border-dashed border-stahl px-5 py-4">
        <PlatzhalterBadge text="In Klärung mit dem Betrieb" />
        <p class="mt-2 text-sm leading-relaxed text-anthrazit-soft">
          Gründungsjahr, Meister-Qualifikation und genaues Einzugsgebiet werden
          ergänzt, sobald der Betrieb sie bestätigt. Hier steht nichts Erfundenes.
        </p>
      </div>
      )}
    </div>
  </div>
</section>
