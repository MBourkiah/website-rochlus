---
/**
 * Footer: schlicht, Haarlinie, Rechtslinks. Bildmarke aus public/logo/
 * (reine Formen, daher als <img> unproblematisch).
 */
const jahr = new Date().getFullYear();
---

<footer class="border-t border-linie">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-base text-anthrazit-soft sm:px-6">
    <p class="flex items-center gap-3">
      <img src="/logo/icon-verband.svg" alt="" width="20" height="20" aria-hidden="true" />
      © {jahr} Fliesenfachbetrieb Rochlus GmbH, Köln
    </p>
    <nav class="flex gap-6" aria-label="Rechtliches">
      <a href="/impressum" class="link py-1">Impressum</a>
      <a href="/datenschutz" class="link py-1">Datenschutz</a>
    </nav>
  </div>
</footer>
