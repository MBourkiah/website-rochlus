---
/**
 * Header: oben eine schmale Kontaktleiste (ab md), darunter Wortmarke,
 * Navigation und Anruf-Knopf. Bis das neue Logo da ist, steht „Rochlus“ als
 * schlichte Wortmarke in der Website-Schrift (Logo-Paket bleibt in public/logo/).
 * Der Anruf-Knopf ist neutral, solange der Hero-Anruf sichtbar ist, danach
 * terrakotta (ein Akzent pro Blick, siehe Base.astro).
 */
import Telefon from './Telefon.astro';
import { istReview } from '../stand';
import { fotos } from '../fotos.mjs';

const nav = [
  { href: '#leistungen', label: 'Leistungen' },
  { href: '#arbeiten', label: 'Unsere Bäder', nurReview: true },
  { href: '#ablauf', label: 'Ablauf' },
  { href: '#betrieb', label: 'Der Betrieb' },
  { href: '#kontakt', label: 'Kontakt' },
].filter((n) => istReview || fotos.referenzen.length > 0 || !n.nurReview);
---

<div class="hidden border-b border-linie bg-hell text-sm text-tinte-soft md:block">
  <div class="mx-auto flex h-10 max-w-7xl items-center justify-between gap-6 px-6 lg:px-8">
    <p>Fliesenfachbetrieb in Köln und Umgebung · Kranzbinderweg 15, 51067 Köln</p>
    <p class="flex items-center gap-6">
      <a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="link">mrochlus@web.de</a>
      <a href="tel:+492219687575" class="link font-semibold text-tinte">0221 968 75 75</a>
    </p>
  </div>
</div>
<header class="sticky top-0 z-40 border-b border-linie bg-weiss/95 backdrop-blur-sm">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex flex-col leading-none" aria-label="Fliesenfachbetrieb Rochlus GmbH, zur Startseite">
      <span class="text-[1.6rem] font-extrabold tracking-[-0.03em]">Rochlus</span>
      <span class="mt-1 text-[0.7rem] font-semibold tracking-[0.14em] text-tinte-soft uppercase">Fliesenfachbetrieb</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Hauptnavigation">
      {
        nav.map((n) => (
          <a
            href={n.href}
            data-spy={n.href.slice(1)}
            class="relative px-3.5 py-2.5 text-[0.95rem] font-semibold text-tinte-soft transition-colors duration-150 hover:text-tinte aria-[current]:text-tinte"
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2.5">
      <a href="tel:+492219687575" class="kopf-anruf knopf knopf-zweit hidden min-h-11 py-2 text-[0.95rem] md:inline-flex">
        <Telefon size={16} /> 0221&nbsp;968&nbsp;75&nbsp;75
      </a>
      <details class="relative lg:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md border border-linie [&::-webkit-details-marker]:hidden" aria-label="Menü">
          <span aria-hidden="true" class="flex flex-col gap-1">
            <span class="block h-0.5 w-4 bg-tinte"></span>
            <span class="block h-0.5 w-4 bg-tinte"></span>
            <span class="block h-0.5 w-4 bg-tinte"></span>
          </span>
        </summary>
        <nav class="absolute right-0 mt-3 flex w-64 flex-col rounded-lg border border-linie bg-weiss p-2 shadow-[0_16px_32px_-16px_rgb(0_0_0/0.3)]" aria-label="Mobile Navigation">
          {
            nav.map((n) => (
              <a href={n.href} class="rounded-md px-4 py-3 text-lg font-semibold hover:bg-hell">
                {n.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  // Mobilmenü: schließt nach Linkklick, mit Esc und bei Tipp daneben
  const menue = document.querySelector('header details');
  if (menue) {
    const schliessen = () => menue.removeAttribute('open');
    menue.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', schliessen));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menue.open) {
        schliessen();
        menue.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menue.open && !menue.contains(e.target)) schliessen();
    });
  }

  const spyLinks = new Map([...document.querySelectorAll('[data-spy]')].map((a) => [a.getAttribute('data-spy'), a]));
  const spy = new IntersectionObserver(
    (eintraege) => {
      for (const e of eintraege) {
        const link = spyLinks.get(e.target.id);
        if (link && e.isIntersecting) {
          spyLinks.forEach((l) => l.removeAttribute('aria-current'));
          link.setAttribute('aria-current', 'true');
        }
      }
    },
    { rootMargin: '-30% 0px -60% 0px' }
  );
  spyLinks.forEach((_, id) => {
    const ziel = document.getElementById(id);
    if (ziel) spy.observe(ziel);
  });
</script>
