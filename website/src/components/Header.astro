---
/**
 * Header: Logo-Wortmarke (verbindlich, public/logo/) inline, damit die Texte
 * darin die self-hosted Fonts nutzen. Die Papier-Hintergrundfläche der SVG
 * wird beim Einbinden entfernt, damit das Logo direkt auf dem Putz steht.
 * Der Anruf-Knopf ist neutral (Kontur), solange der Hero-Anruf sichtbar ist,
 * und wird danach terrakotta (ein Akzent pro Blick, siehe Base.astro).
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Telefon from './Telefon.astro';
import { istReview } from '../stand';
import { fotos } from '../fotos.mjs';

// process.cwd() ist das Astro-Projekt-Root (website/), stabil in dev & build.
const logoLockup = readFileSync(join(process.cwd(), 'public/logo/logo-lockup-light.svg'), 'utf-8').replace(
  /<rect width="640" height="140"[^>]*><\/rect>/,
  ''
).replace('viewBox="0 0 640 140"', 'viewBox="18 40 440 96"');

const nav = [
  { href: '#leistungen', label: 'Leistungen' },
  { href: '#arbeiten', label: 'Unsere Bäder', nurReview: true },
  { href: '#ablauf', label: 'Ablauf' },
  { href: '#betrieb', label: 'Der Betrieb' },
  { href: '#kontakt', label: 'Kontakt' },
].filter((n) => istReview || fotos.referenzen.length > 0 || !n.nurReview);
---

<header class="sticky top-0 z-40 border-b border-linie/70 bg-grund/90 backdrop-blur-md">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex h-11 shrink-0 items-center [&_svg]:h-7 min-[22rem]:[&_svg]:h-8 [&_svg]:w-auto sm:[&_svg]:h-11" aria-label="Fliesenfachbetrieb Rochlus GmbH, zur Startseite">
      <Fragment set:html={logoLockup} />
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Hauptnavigation">
      {
        nav.map((n) => (
          <a
            href={n.href}
            data-spy={n.href.slice(1)}
            class="relative rounded-full px-4 py-2.5 text-[0.95rem] font-semibold text-tinte-soft transition-colors duration-150 hover:bg-flaeche hover:text-tinte aria-[current]:bg-flaeche aria-[current]:text-tinte"
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2.5">
      <a href="tel:+492219687575" class="kopf-anruf knopf knopf-zweit hidden min-h-11 py-2 text-[0.95rem] md:inline-flex">
        <Telefon size={16} />
        <span class="hidden sm:inline">0221&nbsp;968&nbsp;75&nbsp;75</span>
        <span class="max-[22rem]:sr-only sm:hidden">Anrufen</span>
      </a>
      <details class="relative lg:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full bg-flaeche [&::-webkit-details-marker]:hidden" aria-label="Menü">
          <span aria-hidden="true" class="flex flex-col gap-1">
            <span class="block h-0.5 w-4 bg-tinte"></span>
            <span class="block h-0.5 w-4 bg-tinte"></span>
            <span class="block h-0.5 w-4 bg-tinte"></span>
          </span>
        </summary>
        <nav class="absolute right-0 mt-3 flex w-64 flex-col rounded-3xl bg-weiss p-3 shadow-[0_20px_40px_-20px_rgb(0_0_0/0.35)]" aria-label="Mobile Navigation">
          {
            nav.map((n) => (
              <a href={n.href} class="rounded-2xl px-4 py-3.5 text-lg font-semibold hover:bg-flaeche">
                {n.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  // Mobilmenü: schließt nach Linkklick, mit Esc und bei Tipp daneben
  const menue = document.querySelector('header details');
  if (menue) {
    const schliessen = () => menue.removeAttribute('open');
    menue.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', schliessen));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menue.open) {
        schliessen();
        menue.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menue.open && !menue.contains(e.target)) schliessen();
    });
  }

  const spyLinks = new Map([...document.querySelectorAll('[data-spy]')].map((a) => [a.getAttribute('data-spy'), a]));
  const spy = new IntersectionObserver(
    (eintraege) => {
      for (const e of eintraege) {
        const link = spyLinks.get(e.target.id);
        if (link && e.isIntersecting) {
          spyLinks.forEach((l) => l.removeAttribute('aria-current'));
          link.setAttribute('aria-current', 'true');
        }
      }
    },
    { rootMargin: '-30% 0px -60% 0px' }
  );
  spyLinks.forEach((_, id) => {
    const ziel = document.getElementById(id);
    if (ziel) spy.observe(ziel);
  });
</script>
