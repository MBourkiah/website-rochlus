---
/**
 * Header: Logo-Wortmarke (verbindlich, public/logo/) inline, damit die Texte
 * darin die self-hosted Fonts nutzen. Die Papier-Hintergrundfläche der SVG
 * wird beim Einbinden entfernt, damit das Logo direkt auf dem Putz steht.
 * Das Telefon-Schild ist neutral, solange das rote Anruf-Schild im Hero
 * sichtbar ist, und wird danach rot (ein Rot pro Blick, siehe Base.astro).
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Telefon from './Telefon.astro';
import { istReview } from '../stand';

// process.cwd() ist das Astro-Projekt-Root (website/), stabil in dev & build.
const logoLockup = readFileSync(join(process.cwd(), 'public/logo/logo-lockup-light.svg'), 'utf-8').replace(
  /<rect width="640" height="140"[^>]*><\/rect>/,
  ''
).replace('viewBox="0 0 640 140"', 'viewBox="18 40 440 96"');

const nav = [
  { href: '#leistungen', label: 'Leistungen' },
  { href: '#ablauf', label: 'Ablauf' },
  { href: '#betrieb', label: 'Der Betrieb' },
  { href: '#arbeiten', label: 'Arbeiten', nurReview: true },
  { href: '#kontakt', label: 'Kontakt' },
].filter((n) => istReview || !n.nurReview);
---

<header class="sticky top-0 z-40 border-b border-linie bg-putz/95 backdrop-blur-sm">
  <div class="mx-auto flex h-18 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex h-8 shrink-0 items-center sm:h-11 [&_svg]:h-full [&_svg]:w-auto" aria-label="Fliesenfachbetrieb Rochlus GmbH, zur Startseite">
      <Fragment set:html={logoLockup} />
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Hauptnavigation">
      {
        nav.map((n) => (
          <a
            href={n.href}
            data-spy={n.href.slice(1)}
            class="relative px-3.5 py-3 font-schild text-lg font-medium tracking-wide text-anthrazit-soft transition-colors duration-150 hover:text-anthrazit aria-[current]:text-kobalt"
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2.5">
      <a href="tel:+492219687575" class="kopf-anruf schild schild--mini flex min-h-11 items-center gap-2 px-4 font-schild text-lg font-semibold tracking-wide">
        <Telefon size={16} />
        <span class="hidden sm:inline">0221&nbsp;968&nbsp;75&nbsp;75</span>
        <span class="sm:hidden">Anrufen</span>
      </a>
      <details class="relative lg:hidden">
        <summary class="schild schild--mini flex h-11 w-11 cursor-pointer list-none items-center justify-center [&::-webkit-details-marker]:hidden" aria-label="Menü">
          <span aria-hidden="true" class="flex flex-col gap-1">
            <span class="block h-0.5 w-4 bg-anthrazit"></span>
            <span class="block h-0.5 w-4 bg-anthrazit"></span>
            <span class="block h-0.5 w-4 bg-anthrazit"></span>
          </span>
        </summary>
        <nav class="schild absolute right-0 mt-3 flex w-60 flex-col p-4" aria-label="Mobile Navigation">
          {
            nav.map((n) => (
              <a href={n.href} class="border-b border-linie px-3 py-3 font-schild text-xl font-medium last:border-b-0 hover:text-kobalt">
                {n.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  document.querySelectorAll('details nav a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'))
  );

  const spyLinks = new Map([...document.querySelectorAll('[data-spy]')].map((a) => [a.getAttribute('data-spy'), a]));
  const spy = new IntersectionObserver(
    (eintraege) => {
      for (const e of eintraege) {
        const link = spyLinks.get(e.target.id);
        if (link && e.isIntersecting) {
          spyLinks.forEach((l) => l.removeAttribute('aria-current'));
          link.setAttribute('aria-current', 'true');
        }
      }
    },
    { rootMargin: '-30% 0px -60% 0px' }
  );
  spyLinks.forEach((_, id) => {
    const ziel = document.getElementById(id);
    if (ziel) spy.observe(ziel);
  });
</script>
