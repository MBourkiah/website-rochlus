---
/**
 * Hero: echtes Bad als Hintergrundfoto, links abgedunkelt; darauf Aussage,
 * Satz, zwei Knöpfe. Darunter eine Leiste mit belegten Vertrauenspunkten.
 */
import { Image } from 'astro:assets';
import Telefon from './Telefon.astro';
import { fotos } from '../fotos.mjs';

const foto = fotos.bad ?? fotos.referenzen[0];
const vertrauen = [
  { titel: 'Inhabergeführt', text: 'Sie sprechen direkt mit dem Betrieb' },
  { titel: 'Aus einer Hand', text: 'Vom Untergrund bis zur letzten Fuge' },
  { titel: 'Beratung vor Ort', text: 'Wir sehen uns Ihren Raum an' },
  { titel: 'Köln und Umgebung', text: 'Sitz im Kranzbinderweg 15' },
];
---

<section class="auf-foto relative isolate overflow-hidden bg-dunkel text-weiss">
  {
    foto && (
      <Image src={foto.bild} alt="" widths={[640, 960, 1200]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[center_58%] opacity-90" />
    )
  }
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-dunkel/95 via-dunkel/75 to-dunkel/20" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
    <div class="max-w-2xl">
      <h1 class="text-[clamp(2.4rem,5.4vw,4.25rem)] leading-[1.05]">Fliesen, Naturstein und komplette Bäder aus einer Hand.</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85 sm:text-xl">
        Vom ersten Aufmaß bis zur letzten Fuge: Wir planen, sanieren und verlegen
        in Köln und Umgebung. Sie haben einen Ansprechpartner für alles.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="tel:+492219687575" data-hero-anruf class="knopf knopf-anruf min-h-14 px-6 text-lg">
          <Telefon size={20} /> 0221 968 75 75
        </a>
        <a href="#leistungen" class="knopf knopf-zweit min-h-14 px-6 text-lg">Leistungen ansehen</a>
      </div>
    </div>
  </div>
</section>

<section aria-label="Warum Rochlus" class="border-b border-linie bg-weiss">
  <ul class="mx-auto grid max-w-7xl grid-cols-1 divide-y divide-linie px-4 sm:grid-cols-2 sm:divide-y-0 sm:px-6 lg:grid-cols-4 lg:divide-x lg:px-8">
    {
      vertrauen.map((v) => (
        <li class="flex items-start gap-3 py-6 lg:px-6 lg:first:pl-0">
          <svg class="mt-0.5 shrink-0 text-akzent" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="m8 12 3 3 5-6" />
          </svg>
          <span>
            <span class="block font-bold">{v.titel}</span>
            <span class="block text-[0.95rem] text-tinte-soft">{v.text}</span>
          </span>
        </li>
      ))
    }
  </ul>
</section>
