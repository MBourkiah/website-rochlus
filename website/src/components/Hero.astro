---
/**
 * Erster Blick: die Schilderwand am Haus. Großes Kobalt-Schild mit der
 * Aussage, daneben die Hausnummer des Betriebs (Kranzbinderweg 15, belegt)
 * und das einzige rote Schild: der Anruf. Keine Fotos — die vorhandenen sind
 * nur Platzhalter in geringer Auflösung und stehen weiter unten.
 */
import Telefon from './Telefon.astro';
---

<section class="mx-auto grid max-w-6xl grid-cols-1 gap-4 px-4 pt-6 pb-20 sm:gap-5 sm:px-6 sm:pt-10 lg:grid-cols-12 lg:gap-6 lg:pt-14 lg:pb-28">
  <div class="schild schild--kobalt flex flex-col justify-between px-8 pt-11 pb-9 sm:px-14 sm:pt-20 sm:pb-16 lg:col-span-8 lg:row-span-2 lg:min-h-136 lg:px-16">
    <h1 class="text-[clamp(3.4rem,9vw,6rem)] leading-[0.9] font-semibold">
      Fliesen,<br />Naturstein,<br />ganze Bäder.
    </h1>
    <p class="mt-7 max-w-md text-lg sm:mt-10 leading-relaxed text-kobalt-soft sm:text-xl">
      Fliesenfachbetrieb Rochlus aus Köln. Vom ersten Aufmaß bis zur letzten
      Fuge aus einer Hand, für Köln und Umgebung.
    </p>
  </div>

  <!-- Hausnummernschild: Nummer mittig, Straße auf eigenem Schild darunter -->
  <div role="img" aria-label="Unsere Adresse: Kranzbinderweg 15, 51067 Köln" class="flex items-center gap-3 sm:gap-4 lg:col-span-4 lg:col-start-9 lg:row-start-1 lg:flex-col lg:items-stretch">
    <span class="schild schild--kobalt grid h-20 w-20 shrink-0 place-items-center font-schild text-5xl leading-none font-bold max-lg:after:hidden [--rand-abstand:5px] sm:h-24 sm:w-24 sm:text-6xl lg:h-auto lg:w-auto lg:flex-1 lg:text-[7.5rem] lg:[--rand-abstand:9px] lg:[--schraube-abstand:20px]" aria-hidden="true">15</span>
    <span class="schild schild--strasse flex-1 px-8 py-3 text-center font-schild text-lg leading-tight font-semibold sm:text-xl lg:flex-none">
      Kranzbinderweg · 51067 Köln
    </span>
  </div>

  <a
    href="tel:+492219687575"
    data-hero-anruf
    class="schild schild--rot flex flex-col justify-between gap-5 px-8 py-8 sm:gap-8 sm:px-10 sm:py-9 lg:justify-center lg:gap-6 lg:col-span-4 lg:col-start-9 lg:row-start-2 lg:py-10"
  >
    <span class="flex items-center gap-2.5 font-schild text-xl font-semibold tracking-wide">
      <Telefon size={20} /> Anrufen
    </span>
    <span>
      <span class="block font-schild text-[clamp(2.4rem,5vw,3.1rem)] leading-none font-semibold whitespace-nowrap">0221 968 75 75</span>
      <span class="mt-3 block text-base leading-snug text-white/90">Sie sprechen direkt mit dem Betrieb.</span>
    </span>
  </a>

  <div class="flex flex-col gap-x-8 text-base text-anthrazit-soft sm:flex-row sm:flex-wrap lg:col-span-4 lg:col-start-9 lg:flex-col lg:-mt-2">
    <p>
      Niemand erreicht? Mobil:{' '}
      <a href="tel:+491722770674" class="link ziel font-medium whitespace-nowrap text-anthrazit">0172 277 06 74</a>
    </p>
    <p>
      Lieber schreiben?{' '}
      <a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="link ziel font-medium text-anthrazit">Kurze Anfrage per E-Mail</a>
    </p>
  </div>
</section>
