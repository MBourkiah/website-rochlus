---
/**
 * Erster Blick (Werkbank): links die Aussage und der Anhänger (Anruf),
 * rechts ein echtes Bad, an die Wand geklemmt, mit Notizen zu dem, was man
 * sieht. Fotos führen; ohne Projektfoto springt ein Materialbild ein.
 */
import KlemmFoto from './KlemmFoto.astro';
import Anhaenger from './Anhaenger.astro';
import { fotos } from '../fotos.mjs';
import rauten from '../assets/stimmung/rauten-verlegebild.jpg';

const foto = fotos.bad ?? { bild: rauten, alt: 'Weiße Wandfliesen im Rautenmuster', notizen: [] };
---

<section class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-x-12 gap-y-7 px-4 pt-7 pb-20 sm:gap-y-10 sm:px-6 sm:pt-14 lg:grid-cols-12 lg:pt-16 lg:pb-28">
  <KlemmFoto
    bild={foto.bild}
    alt={foto.alt}
    notizen={foto.notizen}
    neigung="1deg"
    vorne
    ohneListe
    sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 70vw, 92vw"
    class="mx-auto w-[54%] max-w-120 sm:w-[62%] lg:order-2 lg:col-span-6 lg:col-start-7 lg:w-full"
  />

  <div class="lg:order-1 lg:col-span-6">
    <h1 class="text-[clamp(2.75rem,8vw,5.75rem)] leading-[0.9]">
      Fliesen, Naturstein, ganze Bäder.
    </h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-graphit-soft sm:mt-6 sm:text-xl">
      Fliesenfachbetrieb Rochlus aus Köln. Vom ersten Aufmaß bis zur letzten
      Fuge aus einer Hand, für Köln und Umgebung.
    </p>
    <div class="mt-6 sm:mt-9">
      <Anhaenger hero />
    </div>
    <p class="mt-6 text-base text-graphit-soft">
      Niemand erreicht? Mobil:{' '}
      <a href="tel:+491722770674" class="link ziel font-semibold whitespace-nowrap text-graphit">0172 277 06 74</a>
      <span class="mx-2 hidden text-linie sm:inline" aria-hidden="true">|</span><br class="sm:hidden" />
      <a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="link ziel font-semibold text-graphit">Anfrage per E-Mail</a>
    </p>
  </div>
</section>
