---
/**
 * Erster Blick (Werkbank): links die Aussage und der Anhänger (Anruf),
 * rechts ein echtes Bad, an die Wand geklemmt, mit Notizen zu dem, was man
 * sieht. Fotos führen; es werden nur echte Rochlus-Fotos gezeigt.
 */
import KlemmFoto from './KlemmFoto.astro';
import Anhaenger from './Anhaenger.astro';
import { fotos } from '../fotos.mjs';
// Nur echte Fotos: ohne Hero-Bad springt das erste Referenzfoto ein
const foto = fotos.bad ?? fotos.referenzen[0];
---

<section class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-x-12 gap-y-7 px-4 pt-12 pb-20 sm:gap-y-10 sm:px-6 sm:pt-14 lg:grid-cols-12 lg:pt-16 lg:pb-28">
  {foto && (
  <KlemmFoto
    bild={foto.bild}
    alt={foto.alt}
    notizen={foto.notizen}
    neigung="1deg"
    vorne
    ohneListe
    sizes="(min-width: 64rem) 40rem, (min-width: 40rem) 70vw, 92vw"
    bildKlasse="aspect-4/3 object-cover object-[center_62%] sm:aspect-auto"
    class="mx-auto w-[92%] sm:w-[62%] lg:order-2 lg:col-span-7 lg:col-start-6 lg:w-[88%]"
  />
  )}

  <div class="lg:order-1 lg:col-span-5 lg:row-start-1">
    <h1 class="text-[clamp(2.75rem,7.4vw,5.25rem)] leading-[0.9]">
      Fliesen, Naturstein, ganze Bäder.
    </h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-graphit-soft sm:mt-6 sm:text-xl">
      Fliesenfachbetrieb Rochlus aus Köln. Vom ersten Aufmaß bis zur letzten
      Fuge aus einer Hand, für Köln und Umgebung.
    </p>
    <div class="mt-6 sm:mt-9">
      <Anhaenger hero />
    </div>
    <p class="mt-6 flex flex-wrap items-center gap-x-6 text-base text-graphit-soft">
      <span>
        Niemand erreicht? Mobil:{' '}
        <a href="tel:+491722770674" class="link ziel font-semibold whitespace-nowrap text-graphit">0172 277 06 74</a>
      </span>
      <a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="link ziel font-semibold text-graphit">Anfrage per E-Mail</a>
    </p>
  </div>
</section>
