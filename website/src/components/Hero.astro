---
/**
 * Erster Blick (Werkbank, kräftig): die Aussage riesig über die ganze Breite,
 * darunter das echte Bad, das an der Zwinge einschwingt und in die Aussage
 * hineinragt; der Anhänger (Anruf) hängt am Foto und pendelt aus.
 * Nur echte Rochlus-Fotos.
 */
import KlemmFoto from './KlemmFoto.astro';
import Anhaenger from './Anhaenger.astro';
import { fotos } from '../fotos.mjs';

const foto = fotos.bad ?? fotos.referenzen[0];
---

<section class="relative mx-auto max-w-6xl overflow-x-clip px-4 pt-10 pb-20 sm:px-6 sm:pt-14 lg:pt-16 lg:pb-28">
  <h1 class="relative z-10 text-[clamp(3rem,10.5vw,6rem)] leading-[0.86] tracking-[-0.03em]">
    <span class="block">Fliesen, Naturstein,</span>
    <span class="block">ganze Bäder.</span>
  </h1>

  <div class="mt-8 grid grid-cols-1 gap-y-10 lg:mt-0 lg:grid-cols-12 lg:gap-x-12">
    <div class="order-2 lg:order-1 lg:col-span-5 lg:pt-14">
      <p class="max-w-md text-lg leading-relaxed text-graphit-soft sm:text-xl">
        Fliesenfachbetrieb Rochlus aus Köln. Vom ersten Aufmaß bis zur letzten
        Fuge aus einer Hand, für Köln und Umgebung.
      </p>
      <p class="mt-6 hidden text-base text-graphit-soft sm:block">
        Lieber schreiben?{' '}
        <a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="link ziel font-semibold text-graphit">Anfrage per E-Mail</a>
      </p>
    </div>

    <!-- Foto ragt ab lg nach oben in die Aussage; der Anhänger hängt unten links am Foto -->
    <div class="relative order-1 lg:order-2 lg:col-span-6 lg:col-start-7 lg:-mt-20">
      {
        foto && (
          <KlemmFoto
            bild={foto.bild}
            alt={foto.alt}
            notizen={foto.notizen}
            neigung="1.2deg"
            bewegung="schwingen"
            vorne
            ohneListe
            sizes="(min-width: 64rem) 40rem, (min-width: 40rem) 80vw, 92vw"
            bildKlasse="aspect-4/3 object-cover object-[center_62%] sm:aspect-auto"
            class="ml-auto w-[94%] sm:w-[78%] lg:w-[90%]"
          />
        )
      }
      <div class="pendel relative z-20 -mt-12 sm:-mt-20 lg:absolute lg:bottom-10 lg:-left-16 lg:mt-0">
        <Anhaenger hero />
      </div>
    </div>
  </div>
</section>
