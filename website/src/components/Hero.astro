---
/**
 * Hero (modern & markant): große, breite Aussage, zwei klare Knöpfe, rechts
 * das echte Bad als große abgerundete Kachel. Darunter drei belegte Fakten.
 * Baut sich beim Laden gestaffelt auf; das Foto öffnet sich aus der Kachel.
 */
import { Image } from 'astro:assets';
import Telefon from './Telefon.astro';
import Pfeil from './Pfeil.astro';
import { fotos } from '../fotos.mjs';

const foto = fotos.bad ?? fotos.referenzen[0];
const fakten = ['Inhabergeführt, direkt mit dem Betrieb', 'Alles rund um die Fliese aus einer Hand', 'Köln und Umgebung'];
---

<section class="mx-auto max-w-7xl px-4 pt-8 pb-16 sm:px-6 lg:px-8 lg:pt-12 lg:pb-24">
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-6">
    <div class="kachel flex min-w-0 flex-col justify-between bg-weiss p-6 sm:p-10 lg:col-span-7 lg:p-14">
      <div>
        <h1 class="hero-teil text-[clamp(2.35rem,6.6vw,5.5rem)] leading-[0.92] hyphens-auto" style="--i:1">
          Fliesen, Naturstein, ganze Bäder.
        </h1>
        <p class="hero-teil mt-6 max-w-xl text-lg leading-relaxed text-tinte-soft sm:text-xl" style="--i:2">
          Fliesenfachbetrieb Rochlus aus Köln: vom ersten Aufmaß bis zur letzten
          Fuge aus einer Hand. Sie sprechen direkt mit dem Betrieb.
        </p>
      </div>
      <div class="hero-teil mt-10 flex flex-wrap items-center gap-3" style="--i:3">
        <a href="tel:+492219687575" data-hero-anruf class="knopf knopf-anruf min-h-14 px-6 text-lg max-sm:w-full">
          <Telefon size={20} /> 0221 968 75 75
        </a>
        <a href="#arbeiten" class="knopf knopf-zweit min-h-14 px-6 text-lg max-sm:w-full">
          Unsere Bäder ansehen <Pfeil />
        </a>
      </div>
    </div>

    {
      foto && (
        <div class="hero-foto hero-parallaxe kachel relative min-h-80 bg-flaeche lg:col-span-5 lg:min-h-0">
          <Image src={foto.bild} alt={foto.alt} widths={[480, 720, 960, 1200]} sizes="(min-width: 64rem) 36rem, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[center_60%]" />
          <span class="absolute bottom-4 left-4 rounded-full bg-weiss/90 px-3.5 py-1.5 text-sm font-semibold backdrop-blur-sm">{foto.etikett}</span>
        </div>
      )
    }
  </div>

  <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-6">
    {
      fakten.map((f, i) => (
        <li class="hero-teil flex items-center gap-3 rounded-2xl border border-linie px-5 py-4 text-base font-semibold" style={`--i:${4 + i}`}>
          <svg class="shrink-0 text-gruen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          {f}
        </li>
      ))
    }
  </ul>
</section>
