---
/**
 * Hero geteilt: links Aussage und Knöpfe auf Weiß, rechts das echte Bad im
 * Hochformat (passt zum Ausgangsfoto, kein Hochskalieren, kein Overlay).
 * Darunter eine konkrete Vertrauensleiste ohne Icons.
 */
import { Image } from 'astro:assets';
import Telefon from './Telefon.astro';
import { fotos } from '../fotos.mjs';

const foto = fotos.bad ?? fotos.referenzen[0];
const vertrauen = [
  ['Sie sprechen mit Marc Rochlus', 'Inhabergeführt, keine Vermittlung'],
  ['Ein Ansprechpartner fürs ganze Bad', 'Vom Untergrund bis zur Fuge'],
  ['Wir kommen zu Ihnen', 'Besichtigung und Beratung vor Ort'],
  ['Aus Köln', 'Kranzbinderweg 15, Einsatz in Köln und Umgebung'],
];
---

<section class="bg-weiss">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-4 pt-10 pb-14 sm:px-6 lg:grid-cols-12 lg:gap-14 lg:px-8 lg:pt-16 lg:pb-20">
    <div class="lg:col-span-6">
      <h1 class="text-[clamp(2.3rem,4.8vw,3.9rem)] leading-[1.05]">Fliesen, Naturstein und komplette Bäder in Köln.</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-tinte-soft sm:text-xl">
        Vom ersten Aufmaß bis zur letzten Fuge aus einer Hand. Sie haben einen
        Ansprechpartner für das ganze Bad und sprechen direkt mit dem Betrieb.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="tel:+492219687575" data-hero-anruf class="knopf knopf-anruf min-h-14 px-6 text-lg">
          <Telefon size={20} /> 0221 968 75 75
        </a>
        <a href="#arbeiten" class="knopf knopf-zweit min-h-14 px-6 text-lg">Bäder ansehen</a>
      </div>
    </div>
    {
      foto && (
        <figure class="lg:col-span-6">
          <Image src={foto.bild} alt={foto.alt} widths={[480, 720, 960, 1200]} sizes="(min-width: 64rem) 36rem, 92vw" loading="eager" fetchpriority="high" class="aspect-4/5 w-full rounded-lg object-cover object-[center_55%] sm:aspect-4/3 lg:aspect-4/5" />
          <figcaption class="mt-3 text-[0.95rem] text-tinte-soft">Von uns gefliest: {foto.etikett}</figcaption>
        </figure>
      )
    }
  </div>

  <ul class="mx-auto grid max-w-7xl grid-cols-1 border-t border-linie px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8" aria-label="Warum Rochlus">
    {
      vertrauen.map(([t, s]) => (
        <li class="border-b border-linie py-5 sm:pr-6 lg:border-b-0 lg:py-7">
          <span class="block font-bold">{t}</span>
          <span class="block text-[0.95rem] text-tinte-soft">{s}</span>
        </li>
      ))
    }
  </ul>
</section>
