---
/**
 * Hero-Variante „Klingeltableau“: Links die Aussage groß auf der Wand, rechts
 * ein Klingeltableau aus Stahl wie am Hauseingang. Drei Klingeln führen zu
 * den Leistungen, die vierte, rote, ist der Anruf bei Rochlus.
 * Die Klingel im Kontakt greift das am Seitenende wieder auf.
 */
import Telefon from './Telefon.astro';
import AnrufRueckfall from './AnrufRueckfall.astro';

const klingeln = [
  { name: 'Fliesen & Naturstein', ziel: '#leistungen' },
  { name: 'Bad-Komplettsanierung', ziel: '#komplettsanierung' },
  { name: 'Abdichtung & Trockenbau', ziel: '#leistungen' },
];
---

<section class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-4 pt-10 pb-20 sm:px-6 sm:pt-14 lg:grid-cols-12 lg:gap-10 lg:pt-20 lg:pb-28">
  <div class="lg:col-span-6">
    <h1 class="text-[clamp(3.4rem,8.5vw,6rem)] leading-[0.9]">Fliesen,<br />Naturstein,<br />ganze Bäder.</h1>
    <p class="mt-8 max-w-md text-lg leading-relaxed text-anthrazit-soft sm:text-xl">
      Fliesenfachbetrieb Rochlus, Kranzbinderweg 15 in Köln. Vom ersten Aufmaß bis zur letzten Fuge aus einer Hand.
    </p>
    <AnrufRueckfall class="mt-6" />
  </div>

  <!-- Das Tableau: Stahlplatte, Sprechgitter, Namensschilder mit Klingeln -->
  <div class="tableau glanz lg:col-span-5 lg:col-start-8">
    <div class="flex items-center justify-between gap-4">
      <span class="schild schild--kobalt grid h-14 w-14 place-items-center font-schild text-3xl leading-none font-bold [--rand-abstand:4px] after:hidden" aria-hidden="true">15</span>
      <span class="tableau-gitter" aria-hidden="true"></span>
    </div>
    <ul class="mt-6 flex flex-col gap-3">
      {
        klingeln.map((k) => (
          <li>
            <a href={k.ziel} class="tableau-zeile group">
              <span class="tableau-name">{k.name}</span>
              <span class="tableau-knopf" aria-hidden="true" />
            </a>
          </li>
        ))
      }
      <li>
        <a href="tel:+492219687575" data-hero-anruf class="tableau-zeile tableau-zeile--rochlus group" aria-label="Rochlus anrufen: 0221 968 75 75">
          <span class="tableau-name tableau-name--rochlus">
            <span class="block font-schild text-2xl leading-none font-semibold">Rochlus</span>
            <span class="mt-1 block font-schild text-[1.9rem] leading-none font-semibold whitespace-nowrap">0221 968 75 75</span>
          </span>
          <span class="klingel-knopf shrink-0"><Telefon size={22} /></span>
        </a>
      </li>
    </ul>
    <p class="mt-4 text-center text-sm text-anthrazit-soft">Klingeln heißt anrufen. Sie sprechen direkt mit dem Betrieb.</p>
  </div>
</section>
