---
/**
 * Hero-Variante „Wegweiser“: Die Hauptaussage ist ein Wegweiser-Mast. Drei
 * Pfeilschilder bilden die H1 und führen zur passenden Section. Rechts
 * Hausnummer, Straße und das rote Anruf-Schild.
 */
import Telefon from './Telefon.astro';
import AnrufRueckfall from './AnrufRueckfall.astro';

const pfeile = [
  { text: 'Fliesen,', ziel: '#leistungen', klasse: 'lg:w-[78%]' },
  { text: 'Naturstein,', ziel: '#leistungen', klasse: 'lg:w-[92%]' },
  { text: 'ganze Bäder.', ziel: '#komplettsanierung', klasse: 'lg:w-full', kobalt: true },
];
---

<section class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 pt-8 pb-20 sm:px-6 sm:pt-12 lg:grid-cols-12 lg:gap-8 lg:pt-16 lg:pb-28">
  <div class="lg:col-span-7">
    <!-- Der Mast: Kappe oben, Rohr, Schellen an jedem Schild, Fuß unten -->
    <div class="relative pl-7 sm:pl-9">
      <span class="absolute top-0 bottom-0 left-2 w-2.5 rounded-sm bg-stahl-hell ring-1 ring-stahl sm:left-3" aria-hidden="true"></span>
      <span class="absolute -top-2 left-1 h-3 w-4.5 rounded-t-full bg-stahl sm:left-2" aria-hidden="true"></span>
      <h1 class="relative flex flex-col gap-3 py-5 sm:gap-4">
        {
          pfeile.map((p) => (
            <a href={p.ziel} class={`hero-pfeil group relative block ${p.klasse}`}>
              <span class="absolute top-1/2 -left-6 h-6 w-4 -translate-y-1/2 rounded-sm bg-anthrazit/70 sm:-left-7" aria-hidden="true" />
              <span class={`pfeil pfeil--gross ${p.kobalt ? 'pfeil--kobalt' : ''}`}>
                <span class="font-schild text-[clamp(2.6rem,7vw,5.25rem)] leading-[0.95] font-semibold">{p.text}</span>
              </span>
            </a>
          ))
        }
      </h1>
    </div>
    <p class="mt-8 max-w-md text-lg leading-relaxed text-anthrazit-soft sm:text-xl">
      Fliesenfachbetrieb Rochlus aus Köln. Vom ersten Aufmaß bis zur letzten Fuge aus einer Hand, für Köln und Umgebung.
    </p>
  </div>

  <div class="flex flex-col gap-4 lg:col-span-5 lg:pt-5">
    <div role="img" aria-label="Unsere Adresse: Kranzbinderweg 15, 51067 Köln" class="flex items-center gap-3 sm:gap-4">
      <span class="schild schild--kobalt grid h-20 w-20 shrink-0 place-items-center font-schild text-5xl leading-none font-bold [--rand-abstand:5px] [--schraube-abstand:11px] max-sm:after:hidden sm:h-24 sm:w-24 sm:text-6xl" aria-hidden="true">15</span>
      <span class="schild schild--strasse flex-1 px-9 py-3 text-center font-schild text-lg leading-tight font-semibold sm:text-xl">Kranzbinderweg · Köln</span>
    </div>
    <a href="tel:+492219687575" data-hero-anruf style="--glanz-verzoegerung: 600ms" class="schild schild--rot glanz flex flex-col gap-5 px-8 py-9 sm:px-10 lg:py-12">
      <span class="flex items-center gap-2.5 font-schild text-xl font-semibold tracking-wide"><Telefon size={20} /> Anrufen</span>
      <span>
        <span class="block font-schild text-[clamp(2.4rem,5vw,3.1rem)] leading-none font-semibold whitespace-nowrap">0221 968 75 75</span>
        <span class="mt-3 block text-base leading-snug text-white/90">Sie sprechen direkt mit dem Betrieb.</span>
      </span>
    </a>
    <AnrufRueckfall class="lg:flex-col" />
  </div>
</section>
