---
/**
 * Komplettsanierung als Schichtung in großer Schrift: von unten (roh) nach
 * oben (fertig) übereinander, ein Bleistiftstrich wächst beim Scrollen mit.
 * Oben die echte Nahaufnahme einer fertigen Rochlus-Oberfläche.
 * Aussagen bleiben bei „rund um die Fliese“ — Sanitär/Elektro sind nicht belegt.
 */
import { Image } from 'astro:assets';
import { fotos } from '../fotos.mjs';

const fertig = fotos.bad?.detail;
// Reihenfolge von oben (fertig) nach unten (roh), wie man auf einen Boden schaut
const schichten = [
  { titel: 'Fliese oder Naturstein', leistung: 'Wand- und Bodenfliesen, Naturstein, edle Materialien, elastische Fugen', fertig: true },
  { titel: 'Kleber und Heizmatte', leistung: 'Verlegung im Dünnbett, auf Wunsch elektrische Fußbodenheizung' },
  { titel: 'Abdichtung', leistung: 'Abdichtungsarbeiten, damit nichts durchfeuchtet' },
  { titel: 'Untergrund', leistung: 'Trockenausbau, Reparaturarbeiten' },
];
---

<section id="komplettsanierung" class="scroll-mt-20">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-24 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:py-32">
    <div class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start">
      <h2 class="text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Ein Bad ist mehr als die Fliese obendrauf.</h2>
      <p class="mt-7 max-w-md text-lg leading-relaxed text-graphit-soft">
        Bei einer Komplettsanierung übernehmen wir jede Schicht rund um die
        Fliese, dazu die Raumgestaltung: Material, Format und Verlegebild
        planen wir mit Ihnen. Ein Ansprechpartner für das ganze Bad.
      </p>
      <p class="mt-8 text-lg">
        Sanierung besprechen:{' '}
        <a href="tel:+492219687575" class="link link-anruf ziel schmal text-2xl font-bold whitespace-nowrap">0221 968 75 75</a>
      </p>
    </div>

    <div class="schichtung relative lg:col-span-7 lg:col-start-6" data-bewegung="strich">
      <span class="bleistiftstrich senkrecht schicht-strich absolute top-4 bottom-4 left-0 w-[2px] bg-graphit" aria-hidden="true"></span>
      <ol class="relative pl-8 sm:pl-12" aria-label="Schichten eines Badbodens, von oben (fertig) nach unten (roh)">
        {
          schichten.map((s, i) => (
            <li class="schicht relative border-b border-linie py-7 last:border-b-0" style={`--i:${i}`}>
              <span class="absolute top-[2.35rem] -left-8 h-3 w-3 -translate-x-[5px] rounded-full bg-graphit ring-4 ring-putz sm:-left-12" aria-hidden="true" />
              <span class="kennzahl schmal block text-sm font-bold tracking-[0.12em] text-graphit-soft uppercase">{s.fertig ? 'Fertig' : i === schichten.length - 1 ? 'Roh' : ' '}</span>
              <span class="schmal block text-[clamp(2rem,4.6vw,3.5rem)] leading-[0.95] font-bold tracking-[-0.02em]">{s.titel}</span>
              <span class="mt-2 block max-w-lg text-base leading-snug text-graphit-soft">{s.leistung}</span>
              {s.fertig && fertig && (
                <span class="probe mt-6 block w-56 sm:absolute sm:top-6 sm:right-0 sm:mt-0 sm:w-44 sm:rotate-2">
                  <Image src={fertig.bild} alt={fertig.alt} widths={[320, 480]} sizes="14rem" class="aspect-4/3 object-cover" />
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
