---
/**
 * Komplettsanierung „von roh zu fertig“: die Schichten eines Badbodens auf
 * einem Bleistiftstrich, von unten (roh) nach oben (fertig). Nur die oberste
 * Schicht zeigt ein Foto, und zwar ein echtes (Nahaufnahme aus dem Hero-Bad);
 * die übrigen Schichten sind Punkte auf dem Strich, keine nachgemalten Proben.
 * Aussagen bleiben bei „rund um die Fliese“ — Sanitär/Elektro sind nicht belegt.
 */
import { Image } from 'astro:assets';
import { fotos } from '../fotos.mjs';

const fertig = fotos.bad?.detail;
const schritte = [
  { titel: 'Untergrund', leistung: 'Trockenausbau, Reparaturarbeiten' },
  { titel: 'Abdichtung', leistung: 'Abdichtungsarbeiten, damit nichts durchfeuchtet' },
  { titel: 'Kleber, auf Wunsch mit Heizmatte', leistung: 'Verlegung im Dünnbett, elektrische Fußbodenheizung' },
  { titel: 'Fliese oder Naturstein', leistung: 'Wand- und Bodenfliesen, Naturstein, edle Materialien, elastische Fugen', fertig: true },
];
---

<section id="komplettsanierung" class="scroll-mt-20">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:py-28">
    <div class="lg:col-span-5">
      <h2 class="text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Ein Bad ist mehr als die Fliese obendrauf.</h2>
      <p class="mt-7 max-w-md text-lg leading-relaxed text-graphit-soft">
        Bei einer Komplettsanierung übernehmen wir jede Schicht rund um die
        Fliese, vom Untergrund bis zur elastischen Fuge. Dazu die
        Raumgestaltung: Material, Format und Verlegebild planen wir mit Ihnen.
      </p>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-graphit-soft">
        Sie haben einen Ansprechpartner, der das ganze Bad im Blick hat.
      </p>
    </div>

    <!-- Schichten: Bleistiftstrich mit Punkten, oben das fertige Ergebnis -->
    <div class="relative lg:col-span-6 lg:col-start-7" data-bewegung="strich">
      <span class="bleistiftstrich senkrecht absolute top-6 bottom-6 left-[0.7rem] w-[1.5px] bg-graphit" aria-hidden="true"></span>
      <ol class="relative flex flex-col-reverse" aria-label="Schichten eines Badbodens, von unten nach oben">
        {
          schritte.map((s) => (
            <li class="relative flex items-start gap-6 py-5">
              <span class={`relative z-10 mt-1.5 shrink-0 rounded-full bg-graphit ring-4 ring-putz ${s.fertig ? 'h-6 w-6 -ml-[0.1rem]' : 'h-3.5 w-3.5 ml-[0.2rem]'}`} aria-hidden="true" />
              <span class="min-w-0">
                <span class="schmal block text-2xl leading-tight font-bold">{s.titel}</span>
                <span class="mt-1 block text-base leading-snug text-graphit-soft">{s.leistung}</span>
                {s.fertig && fertig && (
                  <span class="probe mt-5 block w-48 sm:w-56">
                    <Image src={fertig.bild} alt={fertig.alt} widths={[320, 480]} sizes="14rem" class="aspect-4/3 object-cover" />
                  </span>
                )}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
