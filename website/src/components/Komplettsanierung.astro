---
/**
 * Komplettsanierung als Schichtaufbau: Ein Bad besteht aus Schichten, und
 * jede Schicht ist eine Leistung des Bestands. Der Schnitt ist ein schlichtes
 * Schema (Aufbau von oben nach unten), keine Abbildung eines echten Projekts.
 * Aussagen bleiben bei „rund um die Fliese“ — Sanitär/Elektro sind nicht belegt.
 */
const schichten = [
  { klasse: 'schicht-fliese', name: 'Fliese oder Naturstein', leistung: 'Wand- und Bodenfliesen, Naturstein, edle Materialien' },
  { klasse: 'schicht-kleber', name: 'Fliesenkleber im Dünnbett', leistung: 'Verlegung' },
  { klasse: 'schicht-heizung', name: 'Heizmatte, wenn gewünscht', leistung: 'Elektrische Fußbodenheizung' },
  { klasse: 'schicht-abdichtung', name: 'Abdichtung', leistung: 'Abdichtungsarbeiten' },
  { klasse: 'schicht-untergrund', name: 'Untergrund', leistung: 'Trockenausbau, Reparaturarbeiten' },
];
import { Image } from 'astro:assets';
import rautenVerlegebild from '../assets/stimmung/rauten-verlegebild.jpg';
import { fotos } from '../fotos.mjs';
---

<section id="komplettsanierung" class="scroll-mt-20 border-y border-linie bg-putz-tief/60">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:py-28">
    <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start lg:pt-6">
      <h2 class="text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Ein Bad ist mehr als die Fliese obendrauf.</h2>
      <p class="mt-7 max-w-136 text-lg leading-relaxed text-anthrazit-soft">
        Bei einer Komplettsanierung übernehmen wir jede Schicht rund um die Fliese,
        vom Untergrund bis zur elastischen Fuge am Wandanschluss. Dazu die
        Raumgestaltung: Material, Format und Verlegebild planen wir mit Ihnen.
      </p>
      <p class="mt-5 max-w-136 text-lg leading-relaxed text-anthrazit-soft">
        Sie haben dabei einen Ansprechpartner, der das ganze Bad im Blick hat.
      </p>
      <p class="mt-9 text-lg">
        Sanierung besprechen:{' '}
        <a href="tel:+492219687575" class="link link-anruf ziel font-schild text-2xl font-semibold whitespace-nowrap">0221 968 75 75</a>
      </p>

    </div>

    <div class="lg:col-span-7">
    <figure class="schild px-6 pt-12 pb-8 sm:px-12 sm:pt-14 sm:pb-10">
      <figcaption class="font-schild text-xl font-semibold tracking-wide">Schnitt durch einen Badboden</figcaption>
      <p class="mt-1 text-sm text-anthrazit-soft">Schema, von oben nach unten</p>

      <!-- Querschnitt: links die Schicht, rechts ihre Beschriftung -->
      <ol class="mt-8" data-bewegung="schichten">
        {
          schichten.map((s, i) => (
            <li style={`--i:${i}`} class="group grid min-h-16 grid-cols-[3.5rem_1fr] gap-x-5 sm:grid-cols-[6rem_1fr] sm:gap-x-8">
              <span class={`${s.klasse} border-x border-anthrazit/25 group-first:rounded-t-[3px] group-first:border-t group-last:rounded-b-[3px] group-last:border-b`} aria-hidden="true" />
              <span class="flex flex-col justify-center border-b border-dashed border-linie py-2.5 group-last:border-b-0">
                <span class="font-schild text-lg leading-tight font-semibold">{s.name}</span>
                <span class="text-sm leading-snug text-anthrazit-soft">{s.leistung}</span>
              </span>
            </li>
          ))
        }
      </ol>

      <p class="mt-8 flex items-start gap-3 border-t border-linie pt-5 text-base">
        <span class="mt-2 block h-3 w-1.5 shrink-0 rounded-sm bg-stahl" aria-hidden="true"></span>
        <span>
          <span class="font-schild text-lg font-semibold">Am Wandanschluss:</span>{' '}
          <span class="text-anthrazit-soft">elastische Fuge statt Zementfuge, damit nichts reißt.</span>
        </span>
      </p>
    </figure>
      <!-- Fertiges Bad aus src/fotos.mjs; bis dahin ein Material-Stimmungsbild -->
      {
        fotos.bad ? (
          <figure class="mt-6 rounded-[8px] border border-anthrazit/20 bg-emaille p-1.5 shadow-(--schatten-schild)">
            <img src={fotos.bad.src} alt={fotos.bad.alt} width={fotos.bad.breite} height={fotos.bad.hoehe} class="aspect-4/3 w-full rounded-[4px] object-cover" loading="lazy" />
          </figure>
        ) : (
          /* Material-Stimmungsbild (Unsplash, siehe Bild-Metadaten), bis ein echtes Bad vorliegt */
          <figure class="mt-6 rounded-[8px] border border-anthrazit/20 bg-emaille p-1.5 shadow-(--schatten-schild)">
            <Image src={rautenVerlegebild} alt="Weiße Wandfliesen im Rautenmuster, das wie ein Würfelmuster wirkt" widths={[560, 840, 1120]} sizes="(min-width: 64rem) 40rem, 100vw" class="aspect-[16/8] w-full rounded-[4px] object-cover object-center" />
          </figure>
        )
      }
    </div>
  </div>
</section>
