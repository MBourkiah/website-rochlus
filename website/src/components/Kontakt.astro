---
/**
 * Kontakt: dunkler Abschlussbereich mit großem Anruf-Knopf und den
 * Nebenkanälen. Erreichbarkeitszeiten: Platzhalter, im Launch ausgeblendet.
 */
import Telefon from './Telefon.astro';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import { istReview } from '../stand';
---

<section id="kontakt" class="auf-dunkel scroll-mt-20 bg-dunkel text-weiss">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:px-8 lg:py-28">
    <div class="einblenden lg:col-span-7">
      <h2 class="text-[clamp(2rem,4vw,3.25rem)] leading-tight">Sprechen Sie mit uns über Ihr Bad.</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-dunkel-soft">
        Ein Anruf genügt, dann kommen wir zur Besichtigung. Oder Sie schreiben kurz,
        was ansteht und wo (die Postleitzahl reicht), und wir melden uns.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="tel:+492219687575" data-klingel class="knopf knopf-anruf min-h-14 px-6 text-lg">
          <Telefon size={20} /> 0221 968 75 75
        </a>
        <a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="knopf knopf-zweit min-h-14 px-6 text-lg">E-Mail schreiben</a>
      </div>
    </div>
    <dl class="einblenden grid content-start gap-6 lg:col-span-4 lg:col-start-9">
      <div>
        <dt class="text-sm text-dunkel-soft">Telefon</dt>
        <dd><a href="tel:+492219687575" class="link ziel text-lg font-semibold">0221 968 75 75</a></dd>
      </div>
      <div>
        <dt class="text-sm text-dunkel-soft">Mobil, wenn niemand abnimmt</dt>
        <dd><a href="tel:+491722770674" class="link ziel text-lg font-semibold">0172 277 06 74</a></dd>
      </div>
      <div>
        <dt class="text-sm text-dunkel-soft">E-Mail</dt>
        <dd><a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="link ziel text-lg font-semibold">mrochlus@web.de</a></dd>
      </div>
      <div>
        <dt class="text-sm text-dunkel-soft">Adresse</dt>
        <dd class="text-lg font-semibold">Kranzbinderweg 15, 51067 Köln</dd>
      </div>
      {
        istReview && (
          <div>
            <dt class="text-sm text-dunkel-soft">Erreichbarkeit</dt>
            <dd class="mt-1"><PlatzhalterBadge text="Zeiten folgen vom Betrieb" /></dd>
          </div>
        )
      }
    </dl>
  </div>
</section>
