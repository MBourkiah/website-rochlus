---
/**
 * Kontakt: der große Anhänger als Anruf (Signatur), daneben die Nebenkanäle.
 * Alle Kontaktdaten aus dem Bestand (belegt). Erreichbarkeitszeiten:
 * Platzhalter, im Launch-Stand ausgeblendet.
 */
import Anhaenger from './Anhaenger.astro';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import { istReview } from '../stand';
---

<section id="kontakt" class="scroll-mt-20 border-t border-linie bg-putz-tief/70">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-14 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:py-32">
    <div class="lg:col-span-7">
      <h2 class="text-[clamp(2.8rem,6vw,4.75rem)] leading-[0.92]">Einfach anrufen.</h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-graphit-soft">
        Ein Anruf genügt, dann kommen wir zur Besichtigung. Oder Sie schreiben kurz,
        was ansteht und wo (die Postleitzahl reicht), und wir melden uns.
      </p>
      <div class="mt-10">
        <Anhaenger kontakt gross zusatz="Kranzbinderweg 15, 51067 Köln" />
      </div>
    </div>

    <dl class="grid content-start gap-7 text-base lg:col-span-4 lg:col-start-9 lg:pt-4">
      <div>
        <dt class="schmal text-xl font-bold">Mobil</dt>
        <dd>
          <a href="tel:+491722770674" class="link ziel text-lg">0172 277 06 74</a>
          <span class="block text-graphit-soft">Wenn unter der Festnetznummer niemand abnimmt.</span>
        </dd>
      </div>
      <div>
        <dt class="schmal text-xl font-bold">E-Mail</dt>
        <dd><a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="link ziel text-lg">mrochlus@web.de</a></dd>
      </div>
      {
        istReview && (
          <div>
            <dt class="schmal text-xl font-bold">Erreichbarkeit</dt>
            <dd class="mt-1"><PlatzhalterBadge text="Zeiten folgen vom Betrieb" /></dd>
          </div>
        )
      }
      <div>
        <dt class="schmal text-xl font-bold">Einsatzgebiet</dt>
        <dd class="text-lg text-graphit-soft">Köln und Umgebung</dd>
      </div>
    </dl>
  </div>
</section>
