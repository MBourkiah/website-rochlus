---
/**
 * Kontakt als großer Abschluss auf Grün: Aussage, der große Anruf-Knopf,
 * daneben die Nebenkanäle. Alle Kontaktdaten aus dem Bestand.
 * Erreichbarkeitszeiten: Platzhalter, im Launch-Stand ausgeblendet.
 */
import Telefon from './Telefon.astro';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import { istReview } from '../stand';
---

<section id="kontakt" class="scroll-mt-20 px-4 pb-16 sm:px-6 lg:px-8 lg:pb-24">
  <div class="auf-gruen kachel mx-auto grid max-w-7xl grid-cols-1 gap-12 bg-gruen px-7 py-14 text-weiss sm:px-12 lg:grid-cols-12 lg:gap-10 lg:px-16 lg:py-20">
    <div class="auftauchen lg:col-span-7">
      <h2 class="text-[clamp(2.6rem,6vw,5rem)] leading-[0.92]">Einfach anrufen.</h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-gruen-soft">
        Ein Anruf genügt, dann kommen wir zur Besichtigung. Oder Sie schreiben kurz,
        was ansteht und wo (die Postleitzahl reicht), und wir melden uns.
      </p>
      <a href="tel:+492219687575" data-klingel class="knopf knopf-anruf mt-10 min-h-16 px-7 text-[clamp(1.15rem,3vw,1.9rem)] max-[22rem]:px-4 max-sm:w-full">
        <Telefon size={26} /> <span class="breit font-extrabold">0221 968 75 75</span>
      </a>
    </div>

    <dl class="auftauchen grid content-start gap-6 border-t border-white/15 pt-8 text-base lg:col-span-4 lg:col-start-9 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
      <div>
        <dt class="text-sm font-semibold text-gruen-soft">Mobil, wenn niemand abnimmt</dt>
        <dd><a href="tel:+491722770674" class="link ziel text-lg font-bold">0172 277 06 74</a></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-gruen-soft">E-Mail</dt>
        <dd><a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="link ziel text-lg font-bold">mrochlus@web.de</a></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-gruen-soft">Adresse</dt>
        <dd class="text-lg font-bold">Kranzbinderweg 15, 51067 Köln</dd>
      </div>
      {
        istReview && (
          <div>
            <dt class="text-sm font-semibold text-gruen-soft">Erreichbarkeit</dt>
            <dd class="mt-1"><PlatzhalterBadge text="Zeiten folgen vom Betrieb" /></dd>
          </div>
        )
      }
    </dl>
  </div>
</section>
