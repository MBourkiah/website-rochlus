---
/**
 * Leistungen als drei Hinweistafeln, wie das Verzeichnis im Hauseingang:
 * eine Tafel pro Gruppe, jede Leistung eine Zeile. Das liest sich als Liste,
 * nicht als 13 einzelne Knöpfe, und ist mobil halb so lang.
 * Die führende Gruppe (Verlegen, mit der Komplettsanierung) steht auf Kobalt.
 * Alle 13 Punkte des Bestands bleiben erhalten. Flach, weil nicht klickbar.
 */
const gruppen = [
  {
    titel: 'Verlegen',
    text: 'Das Kernhandwerk, auf Wand und Boden.',
    punkte: ['Komplettsanierung inkl. Raumgestaltung', 'Wand- und Bodenfliesen', 'Naturstein', 'Verarbeitung edler Materialien', 'Elastische Fugen'],
    fuehrend: true,
  },
  {
    titel: 'Unter und neben der Fliese',
    text: 'Damit der Untergrund so gut ist wie die Oberfläche.',
    punkte: ['Trockenausbau', 'Abdichtungsarbeiten', 'Elektrische Fußbodenheizungen', 'Kleine Reparaturarbeiten'],
  },
  {
    titel: 'Planung und Service',
    text: 'Was vor, während und nach der Arbeit passiert.',
    punkte: ['Besichtigung und Beratung vor Ort', 'Individuelle Planung', 'Materialanlieferung', 'Überwachung der Leistungen'],
  },
];
---

<section id="leistungen" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
      <h2 class="max-w-2xl text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Unsere Leistungen, gut ausgeschildert.</h2>
      <p class="max-w-sm text-lg leading-relaxed text-anthrazit-soft">
        Ihr Vorhaben steht nicht dabei? Fragen Sie trotzdem. Oft gehört es dazu.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 items-start gap-5 md:grid-cols-3 md:gap-6">
      {
        gruppen.map((g) => (
          <div class={`schild schild--flach px-7 pt-10 pb-7 sm:px-8 ${g.fuehrend ? 'schild--kobalt' : ''}`}>
            <h3 class="text-2xl leading-tight">{g.titel}</h3>
            <p class={`mt-1 text-base leading-snug ${g.fuehrend ? 'text-kobalt-soft' : 'text-anthrazit-soft'}`}>{g.text}</p>
            <ul class={`mt-5 border-t ${g.fuehrend ? 'border-white/30' : 'border-anthrazit/15'}`}>
              {g.punkte.map((p) => (
                <li class={`border-b py-2.5 font-schild text-xl leading-tight font-semibold last:border-b-0 ${g.fuehrend ? 'border-white/30' : 'border-anthrazit/15'}`}>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
