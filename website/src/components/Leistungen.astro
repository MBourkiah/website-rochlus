---
/**
 * Leistungen: die Komplettsanierung als Hauptblock zuerst (Das Hochwertige
 * nach vorn), darunter die übrigen Leistungen als kompakte Liste ohne Bilder.
 * Alle 13 Punkte des Bestands. Aussagen bleiben bei „rund um die Fliese“.
 */
import Telefon from './Telefon.astro';

const gruppen = [
  { titel: 'Verlegen', punkte: ['Wand- und Bodenfliesen', 'Naturstein', 'Verarbeitung edler Materialien', 'Elastische Fugen'] },
  { titel: 'Untergrund und Technik', punkte: ['Trockenausbau', 'Abdichtungsarbeiten', 'Elektrische Fußbodenheizungen', 'Kleine Reparaturarbeiten'] },
  { titel: 'Planung und Service', punkte: ['Besichtigung und Beratung vor Ort', 'Individuelle Planung', 'Materialanlieferung', 'Überwachung der Leistungen'] },
];
---

<section id="leistungen" class="scroll-mt-20 bg-hell">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <h2 class="einblenden max-w-2xl text-[clamp(2rem,3.6vw,2.75rem)] leading-tight">Was wir für Ihr Bad tun</h2>

    <div id="komplettsanierung" class="einblenden karte mt-10 grid grid-cols-1 gap-8 p-7 sm:p-10 lg:grid-cols-12 lg:p-12">
      <div class="lg:col-span-7">
        <h3 class="text-[clamp(1.6rem,2.6vw,2.1rem)] leading-tight">Komplettsanierung inklusive Raumgestaltung</h3>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-tinte-soft">
          Wir übernehmen jede Schicht rund um die Fliese: Untergrund, Abdichtung,
          Verlegung und Fugen. Material, Format und Verlegebild planen wir mit Ihnen,
          bevor die erste Fliese liegt.
        </p>
      </div>
      <div class="flex flex-col justify-end gap-4 lg:col-span-5 lg:items-end">
        <a href="tel:+492219687575" class="knopf knopf-anruf min-h-13 px-6">
          <Telefon size={18} /> Sanierung besprechen
        </a>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-3">
      {
        gruppen.map((g) => (
          <div class="einblenden">
            <h3 class="border-b border-tinte pb-3 text-lg">{g.titel}</h3>
            <ul class="mt-1">
              {g.punkte.map((p) => (
                <li class="border-b border-linie py-3 text-[1.02rem]">{p}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
