---
/**
 * Schilderwand: Jede der 13 Leistungen des Bestands bekommt ein eigenes
 * Straßenschild, in drei Gruppen an der Wand. Nichts verschwindet im Fließtext.
 * Die Schilder sind reine Beschriftung, keine Links (sie tun nicht so, als
 * wären sie klickbar).
 */
const gruppen = [
  {
    titel: 'Verlegen',
    text: 'Das Kernhandwerk, auf Wand und Boden.',
    schilder: ['Komplettsanierung inkl. Raumgestaltung', 'Wand- und Bodenfliesen', 'Naturstein', 'Verarbeitung edler Materialien', 'Elastische Fugen'],
  },
  {
    titel: 'Unter und neben der Fliese',
    text: 'Damit der Untergrund so gut ist wie die Oberfläche.',
    schilder: ['Trockenausbau', 'Abdichtungsarbeiten', 'Elektrische Fußbodenheizungen', 'Kleine Reparaturarbeiten'],
  },
  {
    titel: 'Planung und Service',
    text: 'Was vor, während und nach der Arbeit passiert.',
    schilder: ['Besichtigung und Beratung vor Ort', 'Individuelle Planung', 'Materialanlieferung', 'Überwachung der Leistungen'],
  },
];
---

<section id="leistungen" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
      <h2 class="max-w-2xl text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Alle 13 Leistungen, gut ausgeschildert.</h2>
      <p class="max-w-sm text-lg leading-relaxed text-anthrazit-soft">
        Ihr Vorhaben steht nicht dabei? Fragen Sie trotzdem. Oft gehört es dazu.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-14 md:grid-cols-3 md:gap-8">
      {
        gruppen.map((m) => (
          <div>
            <h3 class="text-2xl leading-tight">{m.titel}</h3>
            <p class="mt-1 text-base text-anthrazit-soft">{m.text}</p>
            <ul class="mt-6 space-y-3">
                {m.schilder.map((s, i) => (
                  <li class={`schild schild--strasse px-9 py-3.5 font-schild text-xl leading-tight font-semibold ${i === 0 && m.titel === 'Verlegen' ? 'schild--kobalt' : ''}`}>
                    {s}
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
