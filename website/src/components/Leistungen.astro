---
/**
 * Leistungen als großes Verzeichnis: drei Zeilen über die volle Breite, links
 * die Gruppe groß, rechts alle Leistungen als fließender Text. Die Zeilen
 * schieben sich beim Scrollen herein; Hover rückt die Zeile leicht ein.
 * Alle 13 Punkte des Bestands. Echte Nahaufnahme (Mosaik) beim Kernhandwerk.
 */
import { Image } from 'astro:assets';
import { detailMosaikborduere as mosaik } from '../fotos.mjs';

const gruppen = [
  {
    titel: 'Verlegen',
    punkte: ['Komplettsanierung inkl. Raumgestaltung', 'Wand- und Bodenfliesen', 'Naturstein', 'Verarbeitung edler Materialien', 'Elastische Fugen'],
    nahaufnahme: true,
  },
  {
    titel: 'Unter und neben der Fliese',
    punkte: ['Trockenausbau', 'Abdichtungsarbeiten', 'Elektrische Fußbodenheizungen', 'Kleine Reparaturarbeiten'],
  },
  {
    titel: 'Planung und Service',
    punkte: ['Besichtigung und Beratung vor Ort', 'Individuelle Planung', 'Materialanlieferung', 'Überwachung der Leistungen'],
  },
];
---

<section id="leistungen" class="scroll-mt-20 border-y border-linie bg-putz-tief/70">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:py-32">
    <h2 class="max-w-3xl text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Was wir machen, und was dazugehört.</h2>

    <ul class="mt-14 border-t-2 border-graphit">
      {
        gruppen.map((g, i) => (
          <li class="verzeichnis-zeile relative grid grid-cols-1 gap-x-10 gap-y-4 border-b border-graphit/25 py-9 lg:grid-cols-12" style={`--i:${i}`}>
            <h3 class="text-[clamp(2.1rem,4.4vw,3.4rem)] leading-[0.92] tracking-[-0.02em] lg:col-span-5">{g.titel}</h3>
            <p class="schmal text-[clamp(1.25rem,2.2vw,1.65rem)] leading-snug font-semibold lg:col-span-7 lg:pt-1">
              {g.punkte.map((p, j) => (
                <Fragment>
                  <span class="whitespace-nowrap">{p}</span>
                  {j < g.punkte.length - 1 && (
                    <Fragment>
                      {' '}<span class="text-zink" aria-hidden="true">/</span><span class="sr-only">,</span>{' '}
                    </Fragment>
                  )}
                </Fragment>
              ))}
            </p>
            {g.nahaufnahme && (
              <figure class="flex items-center gap-4 lg:col-span-7 lg:col-start-6">
                <span class="probe w-28 shrink-0 -rotate-1">
                  <Image src={mosaik.bild} alt={mosaik.alt} widths={[240, 360]} sizes="7rem" class="aspect-4/3 object-cover" />
                </span>
                <figcaption class="text-sm leading-snug text-graphit-soft">Aus einem unserer Bäder: {mosaik.text}</figcaption>
              </figure>
            )}
          </li>
        ))
      }
    </ul>

    <p class="mt-10 max-w-xl text-lg text-graphit-soft">
      Ihr Vorhaben steht nicht dabei? Oft gehört es trotzdem dazu. Fragen Sie einfach.
    </p>
  </div>
</section>
