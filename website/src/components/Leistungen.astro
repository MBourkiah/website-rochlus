---
/**
 * Leistungen: drei Karten mit Bild, Titel und Liste (alle 13 Punkte des
 * Bestands), darunter ein hervorgehobener Block zur Komplettsanierung.
 * Aussagen bleiben bei „rund um die Fliese“ — Sanitär/Elektro sind nicht belegt.
 */
import { Image } from 'astro:assets';
import Telefon from './Telefon.astro';
import { fotos, detailMosaikborduere as mosaik } from '../fotos.mjs';

const karten = [
  {
    titel: 'Fliesen & Naturstein verlegen',
    bild: fotos.bad?.detail,
    punkte: ['Wand- und Bodenfliesen', 'Naturstein', 'Verarbeitung edler Materialien', 'Elastische Fugen'],
  },
  {
    titel: 'Untergrund & Abdichtung',
    bild: fotos.referenzen[0]?.detail,
    punkte: ['Trockenausbau', 'Abdichtungsarbeiten', 'Elektrische Fußbodenheizungen', 'Kleine Reparaturarbeiten'],
  },
  {
    titel: 'Planung & Service',
    bild: mosaik,
    punkte: ['Besichtigung und Beratung vor Ort', 'Individuelle Planung', 'Materialanlieferung', 'Überwachung der Leistungen'],
  },
];
const sanierung = fotos.referenzen[0];
---

<section id="leistungen" class="scroll-mt-20 bg-hell">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="einblenden max-w-2xl">
      <h2 class="text-[clamp(2rem,3.6vw,2.75rem)] leading-tight">Unsere Leistungen</h2>
      <p class="mt-4 text-lg text-tinte-soft">Alles rund um die Fliese, vom Untergrund bis zur letzten Fuge.</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        karten.map((k) => (
          <article class="einblenden karte flex flex-col">
            {k.bild && <Image src={k.bild.bild} alt={k.bild.alt} widths={[400, 600]} sizes="(min-width: 48rem) 30vw, 100vw" class="aspect-16/10 w-full object-cover" />}
            <div class="flex flex-1 flex-col p-6 lg:p-7">
              <h3 class="text-xl">{k.titel}</h3>
              <ul class="mt-4 space-y-2.5">
                {k.punkte.map((p) => (
                  <li class="flex items-start gap-3 text-[0.98rem]">
                    <svg class="mt-1 shrink-0 text-akzent" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Komplettsanierung hervorgehoben -->
    <div id="komplettsanierung" class="einblenden karte mt-6 grid grid-cols-1 lg:grid-cols-2">
      {sanierung && <Image src={sanierung.bild} alt={sanierung.alt} widths={[480, 720, 960]} sizes="(min-width: 64rem) 40rem, 100vw" class="h-72 w-full object-cover object-[50%_45%] lg:h-full" />}
      <div class="p-7 sm:p-10 lg:p-12">
        <h3 class="text-[clamp(1.6rem,2.6vw,2.2rem)] leading-tight">Komplettsanierung inkl. Raumgestaltung</h3>
        <p class="mt-4 text-lg leading-relaxed text-tinte-soft">
          Wir übernehmen jede Schicht rund um die Fliese: Untergrund, Abdichtung,
          Verlegung und Fugen. Material, Format und Verlegebild planen wir mit Ihnen.
          Sie haben einen Ansprechpartner für das ganze Bad.
        </p>
        <ul class="mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
          {['Besichtigung vor Ort', 'Individuelle Planung', 'Materialanlieferung', 'Ausführung und Überwachung'].map((p) => (
            <li class="flex items-center gap-3 font-semibold">
              <svg class="shrink-0 text-akzent" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {p}
            </li>
          ))}
        </ul>
        <a href="tel:+492219687575" class="knopf knopf-anruf mt-8">
          <Telefon size={18} /> Sanierung besprechen
        </a>
      </div>
    </div>
  </div>
</section>
