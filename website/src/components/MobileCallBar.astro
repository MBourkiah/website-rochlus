---
/**
 * Mobile Anrufleiste: fährt ein, sobald der Anhänger (Anruf) im Hero aus dem
 * Blick ist (ein Rot pro Blick, Logik in Base.astro). Ohne JS immer sichtbar.
 * Safe-Area wird berücksichtigt; index.astro reserviert unten Platz.
 */
import Telefon from './Telefon.astro';
---

<div class="anrufleiste fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1fr_auto] gap-4 border-t border-linie bg-putz/95 px-3 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-sm md:hidden">
  <a href="tel:+492219687575" class="knopf-anruf min-h-13 text-xl">
    <Telefon size={18} /> 0221 968 75 75
  </a>
  <a href="mailto:mrochlus@web.de?subject=Anfrage%20Fliesenarbeiten" class="knopf-neutral min-h-13 px-5 text-xl">
    E-Mail
  </a>
</div>
