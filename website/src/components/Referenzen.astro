---
/**
 * Unsere Bäder (Signatur): ein echtes Bad, an die Wand geklemmt. Beim Scrollen
 * fährt der Blick ins Foto, bis die Nische groß zu sehen ist: „Gute Arbeit
 * erkennt man an der Fuge“, wörtlich. Scroll-gebundene Animation nur, wenn der
 * Browser sie kann und keine reduzierte Bewegung gewünscht ist; sonst Foto
 * plus Nahaufnahme nebeneinander. Weitere Bäder darunter als geklemmte Fotos.
 * Nur echte Rochlus-Fotos. KEINE erfundenen Projektnamen oder Kundenzitate.
 */
import { Image } from 'astro:assets';
import KlemmFoto from './KlemmFoto.astro';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import Zwinge from './Zwinge.astro';
import { fotos } from '../fotos.mjs';

const [haupt, ...weitere] = fotos.referenzen;
const archiv = [
  { src: '/bilder/platzhalter-verlegung-boden.jpg', alt: 'Verlegung großformatiger Bodenfliesen' },
  { src: '/bilder/platzhalter-klebebett.jpg', alt: 'Aufziehen des Klebebetts mit der Zahnkelle' },
  { src: '/bilder/platzhalter-ausrichtung.jpg', alt: 'Ausrichten einer Bodenfliese mit der Wasserwaage' },
  { src: '/bilder/platzhalter-wandarbeiten.jpg', alt: 'Vorbereitete Wandfläche mit Richtschnur' },
];
---

<section id="arbeiten" class="scroll-mt-20 border-y border-linie bg-putz-tief/70">
  {
    haupt ? (
      <div class="lupe" style={`--lupe-x:${haupt.lupe?.x ?? 50}%;--lupe-y:${haupt.lupe?.y ?? 50}%`}>
        <div class="lupe-buehne mx-auto grid max-w-6xl grid-cols-1 items-center gap-x-12 gap-y-8 px-4 py-16 sm:px-6 lg:grid-cols-12 lg:py-0">
          <div class="lg:col-span-5">
            <h2 class="text-[clamp(2.6rem,6vw,4.75rem)] leading-[0.9] tracking-[-0.02em]">Gute Arbeit erkennt man an der Fuge.</h2>
            <p class="mt-6 max-w-md text-lg leading-relaxed text-graphit-soft">
              Ein Bad, das wir gefliest haben: {haupt.etikett}. Scrollen Sie
              weiter, dann gehen wir näher ran.
            </p>
            <p class="lupe-text mt-6 text-lg">
              <span class="schmal block text-2xl font-bold">Nahaufnahme</span>
              <span class="text-graphit-soft">{haupt.detail?.text}</span>
            </p>
            <p class="mt-8 text-lg text-graphit-soft">
              So etwas soll bei Ihnen entstehen?{' '}
              <a href="tel:+492219687575" class="link link-anruf ziel schmal text-2xl font-bold whitespace-nowrap text-graphit">0221 968 75 75</a>
            </p>
          </div>

          <figure class="klemmfoto relative mx-auto w-[86%] max-w-md lg:col-span-6 lg:col-start-7 lg:w-full" style="--neigung:-0.8deg">
            <Zwinge class="klemmfoto-zwinge" style="left:30%" />
            <div class="klemmfoto-rahmen">
              <div class="lupe-fenster overflow-hidden">
                <Image src={haupt.bild} alt={haupt.alt} widths={[480, 720, 960, 1200]} sizes="(min-width: 64rem) 28rem, 86vw" class={`lupe-bild w-full ${haupt.ausschnitt ?? ''}`} />
              </div>
            </div>
          </figure>
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
        <h2 class="max-w-2xl text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Gute Arbeit erkennt man an der Fuge.</h2>
        <div class="mt-14">
          <PlatzhalterBadge text="Fotos: Platzhalter in geringer Auflösung, Originale folgen" />
          <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {archiv.map((a) => (
              <img src={a.src} alt={a.alt} width="210" height="158" loading="lazy" class="aspect-4/3 w-full rounded-sm object-cover" />
            ))}
          </div>
        </div>
      </div>
    )
  }

  {
    weitere.length > 0 && (
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-x-12 gap-y-16 px-4 pb-24 sm:grid-cols-2 sm:px-6">
        {weitere.map((f, i) => (
          <KlemmFoto bild={f.bild} alt={f.alt} notizen={f.notizen} unterschrift={f.etikett} neigung={i % 2 ? '0.8deg' : '-1deg'} bildKlasse={f.ausschnitt ?? ''} sizes="(min-width: 40rem) 45vw, 88vw" class={i % 2 ? 'sm:mt-16' : ''} />
        ))}
      </div>
    )
  }
</section>
