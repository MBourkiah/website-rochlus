---
/**
 * Referenzen: echte Bäder im Bildraster mit kurzer Beschriftung.
 * Ohne Projektfotos in src/fotos.mjs: Archiv-Platzhalter nur im Review-Stand.
 * KEINE erfundenen Projektnamen oder Kundenzitate.
 */
import { Image } from 'astro:assets';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import { fotos, detailMosaikborduere as mosaik } from '../fotos.mjs';

const bilder = [
  fotos.bad && { bild: fotos.bad.bild, alt: fotos.bad.alt, text: fotos.bad.etikett, gross: true },
  ...fotos.referenzen.map((f) => ({ bild: f.bild, alt: f.alt, text: f.etikett, gross: true })),
  ...[fotos.bad?.detail, ...fotos.referenzen.map((f) => f.detail), mosaik].filter(Boolean).map((d) => ({ bild: d.bild, alt: d.alt, text: d.text, gross: false })),
].filter(Boolean);
const archiv = [
  { src: '/bilder/platzhalter-verlegung-boden.jpg', alt: 'Verlegung großformatiger Bodenfliesen' },
  { src: '/bilder/platzhalter-klebebett.jpg', alt: 'Aufziehen des Klebebetts mit der Zahnkelle' },
  { src: '/bilder/platzhalter-ausrichtung.jpg', alt: 'Ausrichten einer Bodenfliese mit der Wasserwaage' },
  { src: '/bilder/platzhalter-wandarbeiten.jpg', alt: 'Vorbereitete Wandfläche mit Richtschnur' },
];
---

<section id="arbeiten" class="scroll-mt-20 bg-weiss">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="einblenden flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="text-[clamp(2rem,3.6vw,2.75rem)] leading-tight">Unsere Bäder</h2>
        <p class="mt-4 text-lg text-tinte-soft">Ein Auszug aus unseren Arbeiten, mit Blick auf die Details.</p>
      </div>
    </div>

    {
      fotos.referenzen.length > 0 ? (
        <div class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
          {bilder.map((b) => (
            <figure class={`einblenden ${b.gross ? 'col-span-2 row-span-2' : ''}`}>
              <div class="overflow-hidden rounded-lg bg-hell">
                <Image src={b.bild} alt={b.alt} widths={b.gross ? [480, 720, 960] : [320, 480]} sizes={b.gross ? '(min-width: 64rem) 36rem, 100vw' : '(min-width: 64rem) 18rem, 50vw'} class={`w-full object-cover transition-transform duration-500 hover:scale-[1.03] ${b.gross ? 'aspect-4/5' : 'aspect-square'}`} />
              </div>
              <figcaption class="mt-3 text-[0.95rem] font-semibold">{b.text}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <div class="mt-12">
          <PlatzhalterBadge text="Fotos: Platzhalter in geringer Auflösung, Originale folgen" />
          <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {archiv.map((a) => (
              <img src={a.src} alt={a.alt} width="210" height="158" loading="lazy" class="aspect-4/3 w-full rounded-lg object-cover" />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
