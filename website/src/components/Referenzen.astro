---
/**
 * Arbeiten: Fotos im Stahlrahmen, jedes mit kleinem Emaille-Etikett.
 *
 * PLATZHALTER: Die vier Motive sind Ausschnitte aus der collage.jpg der
 * Bestandsseite (Original nur 600×420px). Sie werden 1:1 durch Originalfotos
 * ersetzt, sobald der Kunde sie liefert; Vorher/Nachher-Paare passen ins Raster.
 * KEINE erfundenen Projektnamen oder Kundenzitate.
 */
import PlatzhalterBadge from './PlatzhalterBadge.astro';

const motive = [
  { src: '/bilder/platzhalter-verlegung-boden.jpg', alt: 'Verlegung großformatiger Bodenfliesen', etikett: 'Bodenverlegung, Großformat', klasse: '' },
  { src: '/bilder/platzhalter-klebebett.jpg', alt: 'Aufziehen des Klebebetts mit der Zahnkelle', etikett: 'Klebebett im Dünnbett', klasse: 'lg:mt-12' },
  { src: '/bilder/platzhalter-ausrichtung.jpg', alt: 'Ausrichten einer Bodenfliese mit der Wasserwaage', etikett: 'Ausrichten mit der Wasserwaage', klasse: '' },
  { src: '/bilder/platzhalter-wandarbeiten.jpg', alt: 'Vorbereitete Wandfläche mit Richtschnur', etikett: 'Wandarbeiten nach Richtschnur', klasse: 'lg:mt-12' },
];
---

<section id="arbeiten" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="max-w-xl text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95]">Gute Arbeit erkennt man an der Fuge.</h2>
      <PlatzhalterBadge text="Fotos: Platzhalter in geringer Auflösung, Originale folgen" />
    </div>

    <div class="mt-14 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4 lg:gap-x-6">
      {
        motive.map((m) => (
          <figure class={m.klasse}>
            <div class="relative rounded-[8px] border border-anthrazit/20 bg-emaille p-1.5 shadow-(--schatten-schild)">
              <img src={m.src} alt={m.alt} class="aspect-4/3 w-full rounded-[4px] object-cover" loading="lazy" width="210" height="158" />
              <span class="absolute bottom-4 left-4">
                <PlatzhalterBadge text="Platzhalter" />
              </span>
            </div>
            <figcaption class="schild schild--mini mt-3 inline-block px-3.5 py-1.5 font-schild text-base leading-tight font-medium sm:text-lg">{m.etikett}</figcaption>
          </figure>
        ))
      }
    </div>

    <p class="mt-10 max-w-xl text-base leading-relaxed text-anthrazit-soft">
      Hier entsteht die Galerie abgeschlossener Projekte, gern als Vorher/Nachher-Paare.
      Das Raster steht, die Originalfotos kommen vom Betrieb.
    </p>
  </div>
</section>
