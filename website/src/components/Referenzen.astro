---
/**
 * Unsere Bäder: echte Projekte als große Foto-Kacheln mit Detail daneben.
 * Ohne Projektfotos in src/fotos.mjs: Archiv-Platzhalter nur im Review-Stand.
 * KEINE erfundenen Projektnamen oder Kundenzitate.
 */
import { Image } from 'astro:assets';
import Telefon from './Telefon.astro';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import { fotos } from '../fotos.mjs';

const archiv = [
  { src: '/bilder/platzhalter-verlegung-boden.jpg', alt: 'Verlegung großformatiger Bodenfliesen' },
  { src: '/bilder/platzhalter-klebebett.jpg', alt: 'Aufziehen des Klebebetts mit der Zahnkelle' },
  { src: '/bilder/platzhalter-ausrichtung.jpg', alt: 'Ausrichten einer Bodenfliese mit der Wasserwaage' },
  { src: '/bilder/platzhalter-wandarbeiten.jpg', alt: 'Vorbereitete Wandfläche mit Richtschnur' },
];
---

<section id="arbeiten" class="scroll-mt-20 bg-weiss">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="auftauchen flex flex-wrap items-end justify-between gap-6">
      <h2 class="max-w-3xl text-[clamp(2.2rem,4.8vw,4rem)] leading-[0.95]">Gute Arbeit erkennt man an der Fuge.</h2>
      <a href="tel:+492219687575" class="knopf knopf-zweit">
        <Telefon size={18} /> So ein Bad anfragen
      </a>
    </div>

    {
      fotos.referenzen.length > 0 ? (
        <div class="mt-12 grid grid-cols-1 gap-4 lg:grid-cols-12 lg:gap-6">
          {fotos.referenzen.map((f) => (
            <Fragment>
              <figure class="auftauchen foto-zoom kachel relative min-h-[28rem] bg-flaeche lg:col-span-7 lg:min-h-[40rem]">
                <Image src={f.bild} alt={f.alt} widths={[480, 720, 960, 1200]} sizes="(min-width: 64rem) 44rem, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_45%]" />
              </figure>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1 lg:gap-6">
                <div class="auftauchen kachel flex flex-col justify-end bg-flaeche p-7 lg:p-9">
                  <h3 class="text-[clamp(1.6rem,2.6vw,2.2rem)] leading-tight">{f.etikett}</h3>
                  <ul class="mt-4 space-y-1.5 text-base text-tinte-soft">
                    {(f.notizen ?? []).map((n) => <li>{n.text}</li>)}
                  </ul>
                </div>
                {f.detail && (
                  <figure class="auftauchen foto-zoom kachel relative min-h-64 bg-flaeche">
                    <Image src={f.detail.bild} alt={f.detail.alt} widths={[320, 480]} sizes="(min-width: 64rem) 28rem, 50vw" class="absolute inset-0 h-full w-full object-cover" />
                    <figcaption class="absolute bottom-4 left-4 rounded-full bg-weiss/90 px-3.5 py-1.5 text-sm font-semibold backdrop-blur-sm">Detail: {f.detail.text}</figcaption>
                  </figure>
                )}
              </div>
            </Fragment>
          ))}
        </div>
      ) : (
        <div class="mt-12">
          <PlatzhalterBadge text="Fotos: Platzhalter in geringer Auflösung, Originale folgen" />
          <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {archiv.map((a) => (
              <img src={a.src} alt={a.alt} width="210" height="158" loading="lazy" class="kachel aspect-4/3 w-full object-cover" />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
