---
/**
 * Zwei Bäder im Detail: jedes Projektfoto genau einmal, groß, mit den
 * Notizen aus src/fotos.mjs als Liste und der Nahaufnahme klein daneben
 * (nie größer als ihr Ausgangsbild). Das Hero-Bad steht oben im Hero und wird
 * hier nur mit seiner Nahaufnahme aufgegriffen.
 * Ohne Projektfotos: Archiv-Platzhalter nur im Review-Stand.
 */
import { Image } from 'astro:assets';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import { fotos, detailMosaikborduere as mosaik } from '../fotos.mjs';

const faelle = fotos.referenzen.map((f) => ({ ...f, details: [f.detail].filter(Boolean) }));
const weitereDetails = [fotos.bad?.detail, mosaik].filter(Boolean);
const archiv = [
  { src: '/bilder/platzhalter-verlegung-boden.jpg', alt: 'Verlegung großformatiger Bodenfliesen' },
  { src: '/bilder/platzhalter-klebebett.jpg', alt: 'Aufziehen des Klebebetts mit der Zahnkelle' },
  { src: '/bilder/platzhalter-ausrichtung.jpg', alt: 'Ausrichten einer Bodenfliese mit der Wasserwaage' },
  { src: '/bilder/platzhalter-wandarbeiten.jpg', alt: 'Vorbereitete Wandfläche mit Richtschnur' },
];
---

<section id="arbeiten" class="scroll-mt-20 bg-weiss">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="einblenden max-w-2xl">
      <h2 class="text-[clamp(2rem,3.6vw,2.75rem)] leading-tight">Gute Arbeit sieht man im Detail</h2>
      <p class="mt-4 text-lg text-tinte-soft">Bäder, die wir gefliest haben, und was dabei zählt.</p>
    </div>

    {
      faelle.length > 0 ? (
        <div class="mt-12 space-y-16">
          {faelle.map((f) => (
            <article class="einblenden grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-14">
              <Image src={f.bild} alt={f.alt} widths={[480, 720, 960]} sizes="(min-width: 64rem) 34rem, 92vw" class={`w-full rounded-lg lg:col-span-6 ${f.ausschnitt ?? 'aspect-4/5 object-cover'}`} />
              <div class="lg:col-span-6 lg:pt-6">
                <h3 class="text-[clamp(1.5rem,2.4vw,2rem)] leading-tight">{f.etikett}</h3>
                {f.notizen && (
                  <ul class="mt-6 border-t border-linie">
                    {f.notizen.map((n) => (
                      <li class="border-b border-linie py-3 text-[1.02rem]">{n.text}</li>
                    ))}
                  </ul>
                )}
                <div class="mt-8 flex flex-wrap gap-6">
                  {[...f.details, ...weitereDetails].map((d) => (
                    <figure class="w-40">
                      <Image src={d.bild} alt={d.alt} widths={[240, 320]} sizes="10rem" class="aspect-square w-full rounded-md object-cover" />
                      <figcaption class="mt-2 text-sm leading-snug text-tinte-soft">{d.text}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-12">
          <PlatzhalterBadge text="Fotos: Platzhalter in geringer Auflösung, Originale folgen" />
          <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {archiv.map((a) => (
              <img src={a.src} alt={a.alt} width="210" height="158" loading="lazy" class="aspect-4/3 w-full rounded-lg object-cover" />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
