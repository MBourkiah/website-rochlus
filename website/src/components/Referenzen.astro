---
/**
 * Arbeiten: echte Bäder, an die Wand geklemmt, mit Notizen zu dem, was man
 * sieht, und je einer Nahaufnahme aus demselben Foto (die Fuge, die Kante).
 * Nur echte Rochlus-Fotos tragen Zwinge und Rahmen. Steht direkt nach dem
 * Hero. Ohne Einträge in src/fotos.mjs: Archiv-Platzhalter nur im Review-Stand.
 * KEINE erfundenen Projektnamen oder Kundenzitate.
 */
import { Image } from 'astro:assets';
import KlemmFoto from './KlemmFoto.astro';
import PlatzhalterBadge from './PlatzhalterBadge.astro';
import { fotos } from '../fotos.mjs';

const echt = fotos.referenzen.length > 0;
const archiv = [
  { src: '/bilder/platzhalter-verlegung-boden.jpg', alt: 'Verlegung großformatiger Bodenfliesen' },
  { src: '/bilder/platzhalter-klebebett.jpg', alt: 'Aufziehen des Klebebetts mit der Zahnkelle' },
  { src: '/bilder/platzhalter-ausrichtung.jpg', alt: 'Ausrichten einer Bodenfliese mit der Wasserwaage' },
  { src: '/bilder/platzhalter-wandarbeiten.jpg', alt: 'Vorbereitete Wandfläche mit Richtschnur' },
];
const neigungen = ['-1deg', '0.8deg', '-0.5deg'];
const zwingen = [30, 50, 50];
---

<section id="arbeiten" class="scroll-mt-20 border-y border-linie bg-putz-tief/70">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
    <div class="grid grid-cols-1 gap-x-12 gap-y-6 lg:grid-cols-12 lg:items-end">
      <h2 class="text-[clamp(2.4rem,5vw,3.75rem)] leading-[0.95] lg:col-span-6">Gute Arbeit erkennt man an der Fuge.</h2>
      <p class="max-w-md text-lg leading-relaxed text-graphit-soft lg:col-span-5 lg:col-start-8">
        Bäder, die wir gefliest haben, und daneben die Nahaufnahme. Da sieht
        man, ob Kanten und Fugen stimmen.
      </p>
    </div>

    {
      echt ? (
        <div class={`mt-16 grid grid-cols-1 gap-x-12 gap-y-20 ${fotos.referenzen.length === 1 ? 'lg:grid-cols-2' : fotos.referenzen.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3'}`}>
          {fotos.referenzen.map((f, i) => (
            <div class={`${i % 2 ? 'sm:mt-20' : ''} ${fotos.referenzen.length === 1 ? 'grid grid-cols-1 items-center gap-x-12 gap-y-6 sm:grid-cols-2 lg:col-span-2' : ''}`}>
              <KlemmFoto
                bild={f.bild}
                alt={f.alt}
                notizen={f.notizen}
                neigung={neigungen[i % neigungen.length]}
                zwingeX={zwingen[i % zwingen.length]}
                bildKlasse={f.ausschnitt ?? ''}
                ohneListe
                sizes="(min-width: 64rem) 32rem, (min-width: 40rem) 45vw, 88vw"
                class="mx-auto w-[88%] sm:w-full"
              />
              <div>
              <p class="schmal mt-5 text-xl leading-tight font-bold sm:mt-0 sm:text-2xl">{f.etikett}</p>
              {f.detail && (
                <figure class="mt-5 flex items-center gap-5">
                  <span class={`probe shrink-0 ${fotos.referenzen.length === 1 ? 'w-40 sm:w-56' : 'w-32 sm:w-36'}`}>
                    <Image src={f.detail.bild} alt={f.detail.alt} widths={[240, 360, 480]} sizes="14rem" class="aspect-square object-cover" />
                  </span>
                  <figcaption class="text-base leading-snug text-graphit-soft">
                    <span class="block font-semibold text-graphit">Nahaufnahme</span>
                    {f.detail.text}
                  </figcaption>
                </figure>
              )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="mt-14">
          <PlatzhalterBadge text="Fotos: Platzhalter in geringer Auflösung, Originale folgen" />
          <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {archiv.map((a) => (
              <img src={a.src} alt={a.alt} width="210" height="158" loading="lazy" class="aspect-4/3 w-full rounded-sm object-cover" />
            ))}
          </div>
        </div>
      )
    }

    <p class="mt-20 text-lg text-graphit-soft">
      So etwas soll bei Ihnen entstehen?{' '}
      <a href="tel:+492219687575" class="link link-anruf ziel schmal text-2xl font-bold whitespace-nowrap text-graphit">0221 968 75 75</a>
    </p>
  </div>
</section>
