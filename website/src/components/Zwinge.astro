---
/**
 * Schraubzwinge aus Zink, beißt in den oberen Papierrand und hält das Foto an
 * der Wand (rein visuell): Bügel, Spindel mit Gewinde, Druckteller, Griff.
 */
interface Props {
  class?: string;
}
const { class: klasse } = Astro.props;
---

<svg class={klasse} viewBox="0 0 64 54" fill="none" aria-hidden="true">
  <!-- Bügel -->
  <path d="M8 4h40a3 3 0 0 1 3 3v6H14v20H8a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3Z" fill="currentColor" />
  <path d="M8 4h40a3 3 0 0 1 3 3v1.5H5V7a3 3 0 0 1 3-3Z" fill="#fff" fill-opacity="0.35" />
  <!-- Spindel mit Gewinde -->
  <rect x="40.5" y="13" width="5" height="22" fill="#7d8386" />
  <path d="M40.5 16h5M40.5 19h5M40.5 22h5M40.5 25h5M40.5 28h5M40.5 31h5" stroke="#5f6568" stroke-width="1" />
  <!-- Druckteller (beißt aufs Papier) -->
  <rect x="35" y="33" width="16" height="4" rx="1.5" fill="currentColor" />
  <!-- Griff -->
  <rect x="39" y="38" width="8" height="14" rx="3" fill="#a8774a" />
  <rect x="39" y="38" width="3" height="14" rx="1.5" fill="#fff" fill-opacity="0.2" />
</svg>
