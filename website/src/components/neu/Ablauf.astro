---
/** Ablauf /neu: vier Schritte als Zeitleiste, gestaffelt einblendend. */
const schritte = [
  ['Besichtigung vor Ort', 'Wir kommen zu Ihnen, sehen uns Raum und Untergrund an und sagen offen, was geht.'],
  ['Planung', 'Material, Format, Verlegebild und Budget legen wir gemeinsam fest. Sie entscheiden.'],
  ['Ausführung', 'Wir liefern das Material an, führen die Arbeiten aus und überwachen jeden Schritt selbst.'],
  ['Übergabe', 'Wir nehmen gemeinsam ab, bis zur letzten Fuge. Kleine Reparaturen übernehmen wir auch später.'],
];
---

<section id="ablauf" class="scroll-mt-20 bg-(--n-flaeche)">
  <div class="mx-auto max-w-7xl px-4 pt-24 pb-28 sm:px-6 lg:px-8 lg:pt-32 lg:pb-36">
    <h2 class="auf max-w-xl text-[clamp(2rem,3.8vw,3.1rem)] leading-[1.05]">Vom ersten Anruf zum fertigen Bad.</h2>
    <ol class="mt-14 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {schritte.map(([t, s], i) => (
        <li class={`auf ${i % 2 ? 'auf-2' : ''} relative border-t-2 border-(--n-tinte) pt-6 ${i % 2 ? 'lg:mt-10' : ''}`}>
          <span class="text-sm font-medium text-(--n-soft) tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 text-[1.3rem]"><span class="sr-only">Schritt {i + 1}: </span>{t}</h3>
          <p class="mt-2 text-[1rem] leading-relaxed text-(--n-soft)">{s}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
