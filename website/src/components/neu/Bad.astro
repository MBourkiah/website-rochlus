---
/**
 * Ein Bad im Detail (/neu): Zickzack statt Raster. Großes Foto, daneben was
 * man sieht (Notizen aus fotos.mjs) und Nahaufnahmen in gestaffelter Größe.
 */
import { Image } from 'astro:assets';
import Pfeil from './Pfeil.astro';
import { fotos, detailMosaikborduere as mosaik } from '../../fotos.mjs';
const f = fotos.referenzen[0];
const details = [f?.detail, mosaik].filter(Boolean);
---

{f && (
  <section id="bad" class="scroll-mt-20 bg-(--n-flaeche)">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-x-16 gap-y-12 px-4 py-24 sm:px-6 lg:grid-cols-12 lg:px-8 lg:pt-32 lg:pb-36">
      <div class="auf neu-foto lg:col-span-5 lg:row-span-2">
        <Image src={f.bild} alt={f.alt} widths={[480, 720, 960]} sizes="(min-width: 64rem) 30rem, 92vw" class={`w-full ${f.ausschnitt ?? 'aspect-4/5 object-cover'}`} />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-10">
        <h2 class="auf text-[clamp(2rem,3.8vw,3.1rem)] leading-[1.05]">Gute Arbeit sieht man im Detail.</h2>
        <p class="auf auf-2 mt-5 max-w-[34rem] text-lg leading-relaxed text-(--n-soft)">
          {f.etikett}. Darauf achten wir bei jedem Bad:
        </p>
        <ul class="auf auf-2 mt-6 max-w-[34rem]">
          {(f.notizen ?? []).map((n) => (
            <li class="flex items-baseline gap-4 border-t border-(--n-linie) py-3.5 text-[1.05rem] font-medium last:border-b">
              <span class="block h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-[2px] bg-(--n-tinte)" aria-hidden="true" />
              {n.text}
            </li>
          ))}
        </ul>
      </div>
      <div class="auf auf-3 flex items-end gap-5 lg:col-span-6 lg:col-start-7">
        {details.map((d, i) => (
          <figure class={i === 0 ? 'w-44 sm:w-52' : 'w-36 sm:w-40'}>
            <div class="neu-foto-klein"><Image src={d.bild} alt={d.alt} widths={[240, 400]} sizes="13rem" class="aspect-square w-full object-cover" /></div>
            <figcaption class="mt-2 text-[0.85rem] leading-snug text-(--n-soft)">{d.text}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
