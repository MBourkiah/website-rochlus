---
/**
 * Basis-Layout: Fonts (self-hosted via Fontsource), Meta/SEO.
 * Figtree trägt die Seite. Das Logo-Paket (public/logo/) ist bis zum neuen
 * Logo ausgesetzt; im Header steht eine schlichte Wortmarke.
 * noindex nur im Review-Stand; der Launch-Stand (PUBLIC_STAND=launch) ist indexierbar.
 */
import '@fontsource-variable/figtree';
import '../styles/global.css';
import { istReview } from '../stand';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

// Strukturierte Daten: nur belegte Fakten aus dem Bestand (Impressum), nichts erfunden.
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Fliesenfachbetrieb Rochlus GmbH',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kranzbinderweg 15',
    postalCode: '51067',
    addressLocality: 'Köln',
    addressCountry: 'DE',
  },
  telephone: '+492219687575',
  email: 'mrochlus@web.de',
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {istReview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-tinte focus:px-4 focus:py-2 focus:text-weiss"
    >
      Zum Inhalt springen
    </a>
    <slot />
    <!-- Ein Rot pro Blick: Solange das Anruf-Schild im Hero sichtbar ist, bleiben
         Header-Telefon neutral und Call-Bar eingefahren. Seiten ohne Hero-Schild
         (Rechtsseiten) zeigen beide sofort. An der Klingel (Kontakt) treten beide zurück. -->
    <script is:inline>
      const wurzel = document.documentElement;
      const heroAnruf = document.querySelector('[data-hero-anruf]');
      if (!heroAnruf) {
        wurzel.setAttribute('data-anruf-weg', '');
      } else {
        new IntersectionObserver(([e]) => {
          if (e.isIntersecting) wurzel.removeAttribute('data-anruf-weg');
          else wurzel.setAttribute('data-anruf-weg', '');
        }).observe(heroAnruf);
      }
      const klingel = document.querySelector('[data-klingel]');
      if (klingel) {
        new IntersectionObserver(([e]) => {
          if (e.isIntersecting) wurzel.setAttribute('data-klingel-da', '');
          else wurzel.removeAttribute('data-klingel-da');
        }).observe(klingel);
      }
    </script>
  </body>
</html>
