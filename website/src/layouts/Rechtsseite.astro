---
/**
 * Layout für Impressum/Datenschutz: schmale Textspalte, einfache Typo-Stile.
 */
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  ueberschrift: string;
}
const { title, ueberschrift } = Astro.props;
---

<Base title={title} description={ueberschrift + ' — Fliesenfachbetrieb Rochlus GmbH, Köln.'}>
  <Header />
  <main id="inhalt" class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-5xl">{ueberschrift}</h1>
    <div
      class="rechtstext mt-10 space-y-4 text-base leading-relaxed text-anthrazit-soft [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:text-anthrazit [&_h3]:mt-6 [&_h3]:font-semibold [&_h3]:text-anthrazit"
    >
      <slot />
    </div>
  </main>
  <Footer />
</Base>
